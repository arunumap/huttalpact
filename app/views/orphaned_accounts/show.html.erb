<% content_for :title, "Account Inactive — PactBadger" %>
<% content_for :heading, "Account inactive" %>

<div class="text-center space-y-4">
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-100">
    <svg class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
  </div>

  <p class="text-sm text-gray-600">
    Your account is no longer associated with any organization.
  </p>

  <p class="text-sm text-gray-600">
    If you believe this is an error, please contact
    <a href="mailto:support@pactbadger.com" class="font-semibold text-amber-600 hover:text-amber-500">support@pactbadger.com</a>.
  </p>

  <div class="pt-4">
    <%= button_to "Sign out", session_path, method: :delete,
        class: "inline-flex justify-center rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer" %>
  </div>
</div>
