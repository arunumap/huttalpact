<% content_for :page_title, "Pricing" %>
<% content_for :title, "Pricing — Simple, Transparent Plans | PactBadger" %>
<% content_for :meta_description, "Simple, transparent pricing for AI-powered contract tracking. Start free with 10 contracts. Upgrade as your portfolio grows. No credit card required." %>
<% content_for :canonical_url, pricing_url %>

<%= structured_data(type: :faq, items: [
  { question: "Can I change plans later?", answer: "Yes! Upgrade or downgrade at any time. Upgrades take effect immediately. Downgrades apply at the end of your billing period." },
  { question: "How do AI extractions work?", answer: "Upload a contract document (PDF, Word, or image) and our AI reads the document to automatically fill in key fields like dates, values, vendor names, and renewal terms. Each extraction counts toward your billing-period quota." },
  { question: "What happens when I hit my limit?", answer: "You keep full access to existing contracts and data. If your plan includes overage pricing, you can continue extracting. Otherwise, AI extraction pauses until your next billing period or upgrade." },
  { question: "Can I cancel anytime?", answer: "Absolutely. Cancel from the Billing page at any time. You keep access through the end of your current billing period, then revert to the Free plan." },
  { question: "Do you offer refunds?", answer: "If you're not satisfied within the first 14 days, contact us for a full refund. After that, you can cancel anytime but refunds aren't issued for partial billing periods." }
]) %>

<% container_width_class = @plan_tiers.size > 3 ? "max-w-7xl" : "max-w-5xl" %>

<%# ── Header ── %>
<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white pt-12 pb-4" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="relative mx-auto <%= container_width_class %> px-4">
    <div class="text-center animate-on-scroll">
      <div class="inline-flex items-center gap-2 rounded-full bg-green-100/80 px-4 py-1.5 text-sm font-medium text-green-800 ring-1 ring-green-200/60">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        No credit card required
      </div>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Simple, transparent pricing
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Start free and upgrade as your contract operations grow. Every plan includes AI extraction, deadline alerts, and team collaboration.
      </p>
    </div>
  </div>
</section>

<div class="mx-auto <%= container_width_class %> px-4 pb-16" data-controller="pricing-toggle scroll-animate">
  <%# Billing toggle %>
  <div class="flex justify-center py-8 animate-on-scroll">
    <div class="relative flex rounded-full bg-gray-100 p-1 ring-1 ring-gray-200/50">
      <button type="button" data-action="click->pricing-toggle#selectMonthly" data-pricing-toggle-target="monthlyBtn"
              class="relative rounded-full px-5 py-2.5 text-sm font-semibold bg-white text-gray-900 shadow-sm transition-all">
        Monthly
      </button>
      <button type="button" data-action="click->pricing-toggle#selectAnnual" data-pricing-toggle-target="annualBtn"
              class="relative rounded-full px-5 py-2.5 text-sm font-semibold text-gray-500 transition-all">
        Annual <span class="ml-1.5 inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Save 17%</span>
      </button>
    </div>
  </div>

  <%# Manage plan banner %>
  <% if @has_subscription %>
    <div class="mb-8 rounded-xl bg-amber-50 border border-amber-200/60 p-4 text-center">
      <p class="text-sm text-amber-800">
        You're on the <strong><%= @current_plan.titleize %></strong> plan.
        <%= link_to "Manage your plan in Settings", settings_billing_path, class: "font-semibold text-amber-700 underline hover:text-amber-900" %>
      </p>
    </div>
  <% end %>

  <%# Pricing cards %>
  <% card_grid_classes = @plan_tiers.size <= 3 ? "sm:grid-cols-3" : "sm:grid-cols-2 xl:grid-cols-4" %>
  <div class="grid grid-cols-1 gap-6 <%= card_grid_classes %> animate-on-scroll">
    <% @plan_tiers.each_with_index do |tier, idx| %>
      <% monthly_price = number_to_currency(tier.monthly_price_cents.to_f / 100.0, precision: 0) %>
      <% annual_monthly_price = tier.annual_price_cents.to_i.positive? ? number_to_currency(tier.annual_price_cents.to_f / 1200.0, precision: 0) : monthly_price %>
      <% annual_total_price = tier.annual_price_cents.to_i.positive? ? number_to_currency(tier.annual_price_cents.to_f / 100.0, precision: 0) : nil %>
      <% features = tier.feature_list.presence || [
        "#{tier.contract_limit || 'Unlimited'} contracts",
        "#{tier.extraction_limit || 'Unlimited'} AI extractions/billing period",
        "#{tier.user_limit || 'Unlimited'} users",
        (tier.audit_log_days ? "#{tier.audit_log_days}-day activity log" : "Full activity history")
      ] %>
      <% highlighted = tier.featured? || (@current_plan == tier.slug && !tier.free?) %>

      <div class="relative rounded-2xl bg-white p-8 shadow-sm transition-all duration-200 stagger-delay-<%= idx + 1 %>
                  <%= highlighted ? 'ring-2 ring-amber-500 shadow-amber-100/50 shadow-lg scale-[1.02]' : 'ring-1 ring-gray-200 hover:ring-gray-300 hover:shadow-md' %>"
           data-pricing-toggle-target="planCard"
           data-pricing-toggle-monthly-price="<%= monthly_price %>"
           data-pricing-toggle-annual-price="<%= annual_monthly_price %>"
           data-pricing-toggle-monthly-period="/month"
           data-pricing-toggle-annual-period="/month, billed annually"
           data-pricing-toggle-monthly-key="<%= tier.monthly_lookup_key %>"
           data-pricing-toggle-annual-key="<%= tier.annual_lookup_key.presence || tier.monthly_lookup_key %>">
        <% if tier.featured? %>
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-4 py-1 text-xs font-bold text-white shadow-sm">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd" /></svg>
              Most Popular
            </span>
          </div>
        <% end %>

        <h3 class="text-lg font-bold text-gray-900"><%= tier.name %></h3>
        <p class="mt-1.5 text-sm text-gray-500 min-h-[40px]"><%= tier.description.presence || "Flexible plans for your growth stage." %></p>

        <div class="mt-6 flex items-baseline gap-1">
          <span data-pricing-toggle-role="price" class="text-5xl font-extrabold tracking-tight text-gray-900"><%= monthly_price %></span>
          <span data-pricing-toggle-role="period" class="text-sm text-gray-500">/month</span>
        </div>
        <% if annual_total_price.present? %>
          <span data-pricing-toggle-role="annual-total" class="hidden mt-1 text-xs text-gray-400">(billed as <%= annual_total_price %>/year)</span>
        <% end %>

        <div class="mt-8">
          <% if Current.user && @current_plan == tier.slug %>
            <span class="block w-full rounded-xl bg-gray-100 px-4 py-3 text-center text-sm font-semibold text-gray-500">Current Plan</span>
          <% elsif @has_subscription %>
            <%= link_to "Manage your plan", settings_billing_path, class: "block w-full rounded-xl bg-gray-100 px-4 py-3 text-center text-sm font-semibold text-gray-700 hover:bg-gray-200 transition" %>
          <% elsif Current.user && !@is_owner %>
            <span class="block w-full rounded-xl bg-gray-100 px-4 py-3 text-center text-xs font-medium text-gray-500">Contact your organization owner to upgrade</span>
          <% elsif Current.user %>
            <% if tier.free? %>
              <span class="block w-full rounded-xl bg-gray-50 px-4 py-3 text-center text-sm font-medium text-gray-400">&mdash;</span>
            <% elsif tier.monthly_lookup_key.present? %>
              <%= form_with url: checkout_settings_billing_path, method: :post, data: { turbo: false } do %>
                <input type="hidden" name="lookup_key" value="<%= tier.monthly_lookup_key %>" data-pricing-toggle-role="lookup-input">
                <button type="submit" class="block w-full rounded-xl px-4 py-3 text-center text-sm font-semibold text-white transition-all duration-200
                        <%= tier.featured? ? 'bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 shadow-md hover:shadow-lg' : 'bg-gray-900 hover:bg-gray-800' %>">
                  Upgrade to <%= tier.name %>
                </button>
              <% end %>
            <% else %>
              <span class="block w-full rounded-xl bg-gray-50 px-4 py-3 text-center text-sm font-medium text-gray-400">Unavailable</span>
            <% end %>
          <% else %>
            <%= link_to "Get Started", new_registration_path,
                class: "block w-full rounded-xl px-4 py-3 text-center text-sm font-semibold text-white transition-all duration-200 #{tier.featured? ? 'bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 shadow-md hover:shadow-lg' : 'bg-gray-900 hover:bg-gray-800'}" %>
          <% end %>
        </div>

        <ul class="mt-8 space-y-3 text-sm text-gray-600">
          <% features.each do |feature| %>
            <li class="flex items-start gap-2.5">
              <svg class="h-5 w-5 shrink-0 text-green-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              <%= feature %>
            </li>
          <% end %>
        </ul>

        <% if tier.extraction_limit.present? && tier.extraction_overage_cents.to_i.positive? %>
          <p class="mt-4 text-xs text-gray-400 border-t border-gray-100 pt-3">After included extractions: <%= number_to_currency(tier.extraction_overage_cents.to_f / 100.0) %>/extraction.</p>
        <% elsif tier.extraction_limit.present? && tier.paid? %>
          <p class="mt-4 text-xs text-gray-400 border-t border-gray-100 pt-3">AI extraction pauses when quota is reached. Resets next billing period.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# All plans include %>
  <div class="mt-16 animate-on-scroll">
    <div class="rounded-2xl bg-gray-50 ring-1 ring-gray-200/50 p-8 sm:p-10">
      <h3 class="text-center text-lg font-bold text-gray-900">Every plan includes</h3>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <% [
          { icon: "M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z", text: "Bank-level encryption" },
          { icon: "M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0", text: "Proactive alerts" },
          { icon: "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z", text: "Team collaboration" },
          { icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z", text: "Dashboard analytics" }
        ].each do |item| %>
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white shadow-sm ring-1 ring-gray-200/50">
              <svg class="h-5 w-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>" />
              </svg>
            </div>
            <span class="text-sm font-medium text-gray-700"><%= item[:text] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# FAQ Section %>
  <div class="mt-16 mx-auto max-w-3xl animate-on-scroll">
    <h3 class="text-2xl font-bold text-gray-900 text-center">Frequently asked questions</h3>
    <dl class="mt-8 space-y-3">
      <% [
        { q: "Can I change plans later?", a: "Yes! Upgrade or downgrade at any time. Upgrades take effect immediately. Downgrades apply at the end of your billing period." },
        { q: "How do AI extractions work?", a: "Upload a contract document (PDF, Word, or image) and our AI reads the document to automatically fill in key fields like dates, values, vendor names, and renewal terms. Each extraction counts toward your billing-period quota." },
        { q: "What happens when I hit my limit?", a: "You keep full access to existing contracts and data. If your plan includes overage pricing, you can continue extracting. Otherwise, AI extraction pauses until your next billing period or upgrade." },
        { q: "Can I cancel anytime?", a: "Absolutely. Cancel from the Billing page at any time. You keep access through the end of your current billing period, then revert to the Free plan." },
        { q: "Do you offer refunds?", a: "If you're not satisfied within the first 14 days, contact us for a full refund. After that, you can cancel anytime but refunds aren't issued for partial billing periods." }
      ].each do |faq| %>
        <details class="group rounded-xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200/60 transition-all hover:ring-gray-300">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-gray-900">
            <%= faq[:q] %>
            <svg class="h-5 w-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-6 text-gray-600"><%= faq[:a] %></p>
        </details>
      <% end %>
    </dl>
  </div>
</div>
