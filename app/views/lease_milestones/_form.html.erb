<%= form_with model: [contract, lease_milestone], class: "space-y-6" do |form| %>
  <% if lease_milestone.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="text-sm text-red-700">
        <ul class="list-disc space-y-1 pl-5">
          <% lease_milestone.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="border-b border-gray-200 px-6 py-4">
      <h3 class="text-base font-semibold text-gray-900">Milestone Details</h3>
    </div>
    <div class="px-6 py-5 space-y-5">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :milestone_type, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :milestone_type, options_for_select(LeaseMilestone::MILESTONE_TYPES.map { |t| [t.titleize.gsub("_", " "), t] }, lease_milestone.milestone_type), { include_blank: "Select..." }, required: true, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
        <div>
          <%= form.label :due_date, class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :due_date, required: true, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
      </div>
      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex items-center gap-2">
          <%= form.check_box :recurring, class: "h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-600" %>
          <%= form.label :recurring, "This is a recurring milestone", class: "text-sm font-medium text-gray-700" %>
        </div>
        <div>
          <%= form.label :recurrence_interval, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :recurrence_interval, options_for_select(LeaseMilestone::RECURRENCE_INTERVALS.map { |t| [t.titleize, t] }, lease_milestone.recurrence_interval), { include_blank: "One-time" }, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", contract, class: "rounded-lg px-4 py-2 text-sm font-semibold text-gray-700 hover:text-gray-900" %>
    <%= form.submit lease_milestone.persisted? ? "Update Milestone" : "Add Milestone", data: { turbo_submits_with: "Saving..." },
        class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer" %>
  </div>
<% end %>
