<% content_for :page_title, "Settings" %>

<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">
  <%= render "settings/settings_nav", current_tab: "billing" %>

  <div class="max-w-4xl space-y-8">

  <%# ═══════════════════════════════════════════════════════════════════ %>
  <%# Section A: Status Banners (conditional) %>
  <%# ═══════════════════════════════════════════════════════════════════ %>

  <% if @pending_downgrade %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <p class="text-sm text-amber-800">
          Your plan will change to <strong><%= @organization.pending_plan&.titleize %></strong> on
          <strong><%= @organization.pending_plan_effective_at&.strftime("%B %-d, %Y") %></strong>.
        </p>
      </div>
      <%= button_to "Cancel Downgrade", cancel_downgrade_settings_billing_path,
          method: :post,
          data: { turbo_confirm: "Are you sure you want to cancel your pending downgrade?" },
          class: "ml-4 shrink-0 inline-flex items-center rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-500 transition" %>
    </div>
  <% end %>

  <% if @pending_cancellation %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
        <p class="text-sm text-red-800">
          Your subscription will end on
          <strong><%= @subscription&.ends_at&.strftime("%B %-d, %Y") || @subscription&.current_period_end&.strftime("%B %-d, %Y") %></strong>.
          You'll revert to the Free plan.
        </p>
      </div>
      <%= button_to "Resume Subscription", resume_subscription_settings_billing_path,
          method: :post,
          data: { turbo_confirm: "Resume your subscription?" },
          class: "ml-4 shrink-0 inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-500 transition" %>
    </div>
  <% end %>

  <%# ═══════════════════════════════════════════════════════════════════ %>
  <%# Section B: Plan Cards %>
  <%# ═══════════════════════════════════════════════════════════════════ %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5" data-controller="plan-change">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Choose Your Plan</h2>
        <p class="mt-1 text-sm text-gray-500">
          Current plan: <strong><%= @organization.plan_display_name %></strong>
        </p>
      </div>
      <%# Billing toggle %>
      <div class="relative flex rounded-full bg-gray-100 p-1">
        <button type="button" data-action="click->plan-change#selectMonthly" data-plan-change-target="monthlyBtn"
                class="relative rounded-full px-3 py-1.5 text-xs font-semibold bg-white text-gray-900 shadow-sm transition">
          Monthly
        </button>
        <button type="button" data-action="click->plan-change#selectAnnual" data-plan-change-target="annualBtn"
                class="relative rounded-full px-3 py-1.5 text-xs font-semibold text-gray-500 transition">
          Annual <span class="ml-1 text-xs font-medium text-amber-600">Save 17%</span>
        </button>
      </div>
    </div>

    <% billing_grid_classes = @plan_tiers.size <= 3 ? "sm:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-3" %>
    <div class="grid grid-cols-1 <%= billing_grid_classes %> gap-4">
      <% @plan_tiers.each do |tier| %>
        <% monthly_price = number_to_currency(tier.monthly_price_cents.to_f / 100.0, precision: 0) %>
        <% annual_monthly_price = tier.annual_price_cents.to_i.positive? ? number_to_currency(tier.annual_price_cents.to_f / 1200.0, precision: 0) : monthly_price %>
        <% annual_total_price = tier.annual_price_cents.to_i.positive? ? number_to_currency(tier.annual_price_cents.to_f / 100.0, precision: 0) : nil %>
        <% features = tier.feature_list.presence || [
          "#{tier.contract_limit || 'Unlimited'} contracts",
          "#{tier.extraction_limit || 'Unlimited'} AI extractions/billing period",
          "#{tier.user_limit || 'Unlimited'} users",
          (tier.audit_log_days ? "#{tier.audit_log_days}-day activity log" : "Full activity log")
        ] %>

        <div class="rounded-xl p-5 ring-1 <%= @organization.plan == tier.slug ? 'ring-amber-500 bg-amber-50/30' : 'ring-gray-200 bg-white' %>"
             data-plan-change-target="planCard"
             data-plan-change-monthly-price="<%= monthly_price %>"
             data-plan-change-annual-price="<%= annual_monthly_price %>"
             data-plan-change-monthly-period="/month"
             data-plan-change-annual-period="/month, billed annually"
             data-plan-change-monthly-key="<%= tier.monthly_lookup_key %>"
             data-plan-change-annual-key="<%= tier.annual_lookup_key.presence || tier.monthly_lookup_key %>">
          <h3 class="text-base font-semibold text-gray-900"><%= tier.name %></h3>
          <div class="mt-3">
            <span data-plan-change-role="price" class="text-3xl font-bold text-gray-900"><%= monthly_price %></span>
            <span data-plan-change-role="period" class="text-sm text-gray-500">/month</span>
            <% if annual_total_price.present? %>
              <span data-plan-change-role="annual-total" class="hidden block mt-1 text-xs text-gray-400">(billed as <%= annual_total_price %>/year)</span>
            <% end %>
          </div>

          <ul class="mt-4 space-y-2 text-xs text-gray-600">
            <% features.each do |feature| %>
              <li><%= feature %></li>
            <% end %>
          </ul>
          <% if tier.extraction_limit.present? && tier.extraction_overage_cents.to_i.positive? %>
            <p class="mt-2 text-xs text-gray-500">Overage: <%= number_to_currency(tier.extraction_overage_cents.to_f / 100.0) %>/extraction after included quota.</p>
          <% end %>

          <div class="mt-5">
            <% if @organization.plan == tier.slug %>
              <span class="block w-full rounded-lg bg-gray-100 px-3 py-2 text-center text-xs font-semibold text-gray-500">Current Plan</span>
            <% elsif @organization.pending_downgrade? && @organization.pending_plan == tier.slug %>
              <span class="block w-full rounded-lg bg-amber-100 px-3 py-2 text-center text-xs font-semibold text-amber-700">Downgrade Scheduled</span>
            <% elsif tier.free? && @organization.downgrade_from_current?(tier.slug) %>
              <% eligibility = @downgrade_eligibility[tier.slug] %>
              <% if eligibility && eligibility[:eligible] %>
                <%= button_to "Downgrade to #{tier.name}", cancel_subscription_settings_billing_path,
                    method: :post,
                    data: { turbo_confirm: "Are you sure? Your plan will revert to #{tier.name} at the end of your billing period." },
                    class: "block w-full rounded-lg bg-gray-100 px-3 py-2 text-center text-xs font-semibold text-gray-700 hover:bg-gray-200 transition" %>
              <% elsif eligibility %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400 cursor-not-allowed"
                      title="<%= eligibility[:blockers].join(' ') %>">
                  Cannot Downgrade
                </span>
              <% else %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400">—</span>
              <% end %>
            <% elsif @organization.upgrade_from_current?(tier.slug) %>
              <% if tier.monthly_lookup_key.present? %>
                <% if @organization.free_plan? %>
                  <%= form_with url: checkout_settings_billing_path, method: :post, class: "w-full" do |f| %>
                    <input type="hidden" name="lookup_key" value="<%= tier.monthly_lookup_key %>" data-plan-change-role="lookup-input">
                    <button type="submit" data-turbo-submits-with="Processing…"
                            class="block w-full rounded-lg bg-amber-600 px-3 py-2 text-center text-xs font-semibold text-white hover:bg-amber-500 transition">
                      Get Started
                    </button>
                  <% end %>
                <% else %>
                  <%= form_with url: upgrade_settings_billing_path, method: :post, class: "w-full" do |f| %>
                    <input type="hidden" name="lookup_key" value="<%= tier.monthly_lookup_key %>" data-plan-change-role="lookup-input">
                    <button type="submit" data-turbo-confirm="Upgrade to <%= tier.name %>? You'll be charged a prorated amount immediately." data-turbo-submits-with="Processing…"
                            class="block w-full rounded-lg bg-amber-600 px-3 py-2 text-center text-xs font-semibold text-white hover:bg-amber-500 transition">
                      Upgrade to <%= tier.name %>
                    </button>
                  <% end %>
                <% end %>
              <% else %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400">Unavailable</span>
              <% end %>
            <% elsif @organization.downgrade_from_current?(tier.slug) %>
              <% eligibility = @downgrade_eligibility[tier.slug] %>
              <% if eligibility && eligibility[:eligible] && tier.monthly_lookup_key.present? %>
                <%= form_with url: downgrade_settings_billing_path, method: :post, class: "w-full" do |f| %>
                  <input type="hidden" name="lookup_key" value="<%= tier.monthly_lookup_key %>" data-plan-change-role="lookup-input">
                  <button type="submit" data-turbo-confirm="Are you sure? Your plan will change to <%= tier.name %> at the end of your billing period."
                          class="block w-full rounded-lg bg-gray-100 px-3 py-2 text-center text-xs font-semibold text-gray-700 hover:bg-gray-200 transition">
                    Downgrade to <%= tier.name %>
                  </button>
                <% end %>
              <% elsif eligibility && eligibility[:eligible] %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400">Unavailable</span>
              <% elsif eligibility %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400 cursor-not-allowed"
                      title="<%= eligibility[:blockers].join(' ') %>">
                  Cannot Downgrade
                </span>
              <% else %>
                <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400">—</span>
              <% end %>
            <% else %>
              <span class="block w-full rounded-lg bg-gray-50 px-3 py-2 text-center text-xs font-medium text-gray-400">—</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ═══════════════════════════════════════════════════════════════════ %>
  <%# Section C: Usage Meters %>
  <%# ═══════════════════════════════════════════════════════════════════ %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-lg font-semibold text-gray-900">Usage</h2>
    <p class="mt-1 text-sm text-gray-500">Your current resource usage against plan limits.</p>
    <% extraction_period_end = @organization.extraction_period_end %>
    <% overage_rate_cents = @organization.plan_extraction_overage_cents %>
    <% overage_estimate_cents = @organization.estimated_extraction_overage_cents %>

    <div class="mt-6 space-y-6">
      <%# Contracts %>
      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">Contracts</span>
          <span class="text-gray-500">
            <%= @organization.active_contracts_count %> / <%= @organization.plan_contract_limit == Float::INFINITY ? "∞" : @organization.plan_contract_limit %>
          </span>
        </div>
        <% contract_pct = @organization.plan_contract_limit == Float::INFINITY ? 0 : (@organization.active_contracts_count.to_f / @organization.plan_contract_limit * 100).clamp(0, 100) %>
        <div class="mt-2 overflow-hidden rounded-full bg-gray-200 h-2">
          <div class="h-2 rounded-full <%= contract_pct >= 90 ? 'bg-red-500' : contract_pct >= 70 ? 'bg-amber-500' : 'bg-green-500' %>" style="width: <%= contract_pct %>%"></div>
        </div>
      </div>

      <%# AI Extractions %>
      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">AI Extractions (this billing period)</span>
          <span class="text-gray-500">
            <%= @organization.ai_extractions_count %> / <%= @organization.plan_extraction_limit == Float::INFINITY ? "∞" : @organization.plan_extraction_limit %>
          </span>
        </div>
        <% extraction_pct = @organization.plan_extraction_limit == Float::INFINITY ? 0 : (@organization.ai_extractions_count.to_f / @organization.plan_extraction_limit * 100).clamp(0, 100) %>
        <div class="mt-2 overflow-hidden rounded-full bg-gray-200 h-2">
          <div class="h-2 rounded-full <%= extraction_pct >= 90 ? 'bg-red-500' : extraction_pct >= 70 ? 'bg-amber-500' : 'bg-green-500' %>" style="width: <%= extraction_pct %>%"></div>
        </div>
        <p class="mt-1 text-xs text-gray-400">Resets on <%= extraction_period_end.strftime("%B %-d, %Y") %></p>
        <% if @organization.extraction_overage_count.positive? %>
          <p class="mt-1 text-xs text-amber-700">
            Overage usage this billing period: <%= @organization.extraction_overage_count %>
            (<%= number_to_currency(overage_estimate_cents.to_f / 100.0) %> pending at <%= number_to_currency(overage_rate_cents.to_f / 100.0) %>/extraction).
          </p>
        <% elsif @organization.extraction_overage_enabled? %>
          <p class="mt-1 text-xs text-gray-500">
            Additional extractions are billed at <%= number_to_currency(overage_rate_cents.to_f / 100.0) %>/extraction after your included quota.
          </p>
        <% end %>
      </div>

      <%# Team Members %>
      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-gray-700">Team Members</span>
          <span class="text-gray-500">
            <%= @organization.memberships.count %> / <%= @organization.plan_user_limit == Float::INFINITY ? "∞" : @organization.plan_user_limit %>
          </span>
        </div>
        <% user_pct = @organization.plan_user_limit == Float::INFINITY ? 0 : (@organization.memberships.count.to_f / @organization.plan_user_limit * 100).clamp(0, 100) %>
        <div class="mt-2 overflow-hidden rounded-full bg-gray-200 h-2">
          <div class="h-2 rounded-full <%= user_pct >= 90 ? 'bg-red-500' : user_pct >= 70 ? 'bg-amber-500' : 'bg-green-500' %>" style="width: <%= user_pct %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <%# ═══════════════════════════════════════════════════════════════════ %>
  <%# Section D: Billing Details (paid users only) %>
  <%# ═══════════════════════════════════════════════════════════════════ %>

  <% if @subscription %>
    <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <h2 class="text-lg font-semibold text-gray-900">Billing Details</h2>
      <div class="mt-4 rounded-lg bg-gray-50 p-4">
        <dl class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="font-medium text-gray-500">Status</dt>
            <dd class="mt-1 text-gray-900"><%= @subscription.status.titleize %></dd>
          </div>
          <div>
            <dt class="font-medium text-gray-500">Next billing date</dt>
            <dd class="mt-1 text-gray-900"><%= @subscription.current_period_end&.strftime("%B %-d, %Y") || "—" %></dd>
          </div>
        </dl>
      </div>
      <div class="mt-4">
        <%= link_to "Payment Methods & Invoices", portal_settings_billing_path,
            class: "inline-flex items-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition" %>
      </div>
    </div>
  <% end %>

  <%# ═══════════════════════════════════════════════════════════════════ %>
  <%# Section E: Danger Zone %>
  <%# ═══════════════════════════════════════════════════════════════════ %>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-red-200">
    <h2 class="text-lg font-semibold text-red-600">Danger Zone</h2>

    <% if @organization.paid_plan? && !@pending_cancellation %>
      <div class="mt-4 flex items-center justify-between rounded-lg border border-red-200 p-4">
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Cancel Subscription</h3>
          <p class="mt-1 text-xs text-gray-500">You'll keep access to your current plan until the end of your billing period, then revert to Free.</p>
        </div>
        <%= button_to "Cancel Subscription", cancel_subscription_settings_billing_path,
            method: :post,
            data: { turbo_confirm: "Are you sure you want to cancel? You'll keep access to #{@organization.plan.titleize} until your billing period ends, then revert to Free." },
            class: "ml-4 shrink-0 inline-flex items-center rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-red-600 ring-1 ring-inset ring-red-300 hover:bg-red-50 transition" %>
      </div>
    <% end %>

    <div class="mt-4 rounded-lg border border-red-200 p-4" data-controller="account-delete">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Delete Account</h3>
          <p class="mt-1 text-xs text-gray-500">Permanently delete your organization, all contracts, documents, and data. This cannot be undone.</p>
        </div>
        <button type="button" data-action="click->account-delete#toggle"
                class="ml-4 shrink-0 inline-flex items-center rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-red-600 ring-1 ring-inset ring-red-300 hover:bg-red-50 transition">
          Delete Account
        </button>
      </div>

      <div data-account-delete-target="form" class="hidden mt-4 rounded-lg bg-red-50 p-4 border border-red-200">
        <p class="text-sm text-red-800 font-medium mb-3">Enter your password to confirm account deletion:</p>
        <%= form_with url: destroy_account_settings_billing_path, method: :delete, class: "space-y-3" do |f| %>
          <div>
            <input type="password" name="password" placeholder="Enter your password" required
                   data-account-delete-target="passwordInput"
                   data-action="input->account-delete#validatePassword"
                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 text-sm">
          </div>
          <div class="flex items-center gap-3">
            <button type="submit" data-account-delete-target="submitBtn" disabled
                    class="inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-500 disabled:opacity-50 disabled:cursor-not-allowed transition">
              Permanently Delete Account
            </button>
            <button type="button" data-action="click->account-delete#toggle"
                    class="text-xs text-gray-500 hover:text-gray-700">
              Cancel
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  </div>
</div>
