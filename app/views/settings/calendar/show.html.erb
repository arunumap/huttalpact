<% content_for :page_title, "Settings" %>

<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">
  <%= render "settings/settings_nav", current_tab: "calendar" %>

  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900">Calendar Integration</h2>
    <p class="mt-1 text-sm text-gray-500">Sync contract deadlines and milestones to your calendar for <strong><%= current_organization.name %></strong>.</p>
  </div>

  <% if @connection&.active? %>
    <%# Connected state %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg divide-y divide-gray-200">
      <%# Connection status %>
      <div class="p-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900">
                <%= @connection.provider.titleize %> Calendar Connected
              </h3>
              <p class="text-xs text-gray-500">
                <%= @connection.provider_email || "Connected" %>
                <% if @connection.last_synced_at.present? %>
                  · Last synced <%= time_ago_in_words(@connection.last_synced_at) %> ago
                <% end %>
              </p>
            </div>
          </div>
          <%= button_to "Disconnect", disconnect_settings_calendar_path, method: :delete,
                class: "text-sm font-medium text-red-600 hover:text-red-500",
                data: { turbo_confirm: "This will remove all synced calendar events. Are you sure?" } %>
        </div>

        <% if @connection.last_error.present? %>
          <div class="mt-3 rounded-md bg-red-50 p-3">
            <p class="text-xs text-red-700"><strong>Sync error:</strong> <%= @connection.last_error.truncate(200) %></p>
          </div>
        <% end %>
      </div>

      <% if @preference&.remote_calendar_id.present? %>
        <%# Sync preferences %>
        <%= form_with url: settings_calendar_path, method: :patch, class: "divide-y divide-gray-200" do |f| %>
          <div class="p-6">
            <h3 class="text-sm font-semibold text-gray-900 mb-1">Sync Settings</h3>
            <p class="text-xs text-gray-500 mb-4">Choose which contract obligation types to sync to <strong><%= @preference.remote_calendar_name || "your calendar" %></strong>.</p>

            <label class="flex items-start gap-3 cursor-pointer mb-4">
              <%= f.check_box "calendar_preference[sync_enabled]", { checked: @preference.sync_enabled?, class: "mt-1 h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-500" }, "1", "0" %>
              <div>
                <span class="text-sm font-medium text-gray-900">Enable calendar sync</span>
                <p class="text-xs text-gray-500">When disabled, no new events are created and existing events stop updating.</p>
              </div>
            </label>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
              <% CalendarPreference::ALL_CATEGORIES.each do |category| %>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox"
                         name="calendar_preference[enabled_categories][]"
                         value="<%= category %>"
                         <%= "checked" if @preference.effective_categories.include?(category) %>
                         class="h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-500">
                  <span class="text-sm text-gray-700"><%= category.titleize.gsub("_", " ") %></span>
                </label>
              <% end %>
            </div>
            <%# Hidden field to ensure empty array is submitted when all unchecked %>
            <input type="hidden" name="calendar_preference[enabled_categories][]" value="">
          </div>

          <div class="flex items-center justify-between px-6 py-4 bg-gray-50 rounded-b-lg">
            <span class="text-xs text-gray-500">
              Reminder timing uses your
              <%= link_to "Alert Settings", settings_alerts_path, class: "text-amber-600 hover:text-amber-500 underline" %>
            </span>
            <%= f.submit "Save Preferences", data: { turbo_submits_with: "Saving..." },
                  class: "rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 cursor-pointer" %>
          </div>
        <% end %>
      <% else %>
        <%# Calendar selection %>
        <div class="p-6">
          <h3 class="text-sm font-semibold text-gray-900 mb-4">Choose a Calendar</h3>
          <% if @calendars.present? %>
            <%= form_with url: select_calendar_settings_calendar_path, method: :post do |f| %>
              <div class="space-y-2">
                <% @calendars.each do |cal| %>
                  <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer">
                    <%= f.radio_button "calendar_preference[remote_calendar_id]", cal[:id],
                          class: "h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300" %>
                    <div>
                      <span class="text-sm font-medium text-gray-900"><%= cal[:name] %></span>
                      <% if cal[:primary] %>
                        <span class="ml-1 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Primary</span>
                      <% end %>
                    </div>
                    <%= f.hidden_field "calendar_preference[remote_calendar_name]", value: cal[:name] %>
                  </label>
                <% end %>
              </div>
              <%# Default all categories enabled %>
              <% CalendarPreference::ALL_CATEGORIES.each do |cat| %>
                <input type="hidden" name="calendar_preference[enabled_categories][]" value="<%= cat %>">
              <% end %>
              <div class="mt-4">
                <%= f.submit "Select Calendar & Start Sync", data: { turbo_submits_with: "Setting up..." },
                      class: "rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 cursor-pointer" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">No writable calendars found. Make sure your account has calendar access.</p>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>
    <%# Disconnected state %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-2">Connect a Calendar</h3>
        <p class="text-sm text-gray-500 mb-6">
          Connect your Google or Microsoft account to automatically sync contract deadlines,
          renewal dates, lease milestones, and other obligations to your calendar.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <%= link_to connect_google_settings_calendar_path,
                class: "inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2" do %>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            Connect Google Calendar
          <% end %>

          <%= link_to connect_microsoft_settings_calendar_path,
                class: "inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2" do %>
            <svg class="w-5 h-5" viewBox="0 0 23 23" fill="none"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
            Connect Microsoft Outlook
          <% end %>
        </div>
      </div>

      <div class="border-t border-gray-200 p-6 bg-gray-50 rounded-b-lg">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">What gets synced</h4>
        <ul class="text-xs text-gray-500 space-y-1">
          <li>✓ Contract renewal and expiration dates</li>
          <li>✓ Notice period start dates</li>
          <li>✓ Option exercise deadlines</li>
          <li>✓ Rent escalation dates</li>
          <li>✓ CAM reconciliation and TI deadlines</li>
          <li>✓ Recurring lease milestones</li>
        </ul>
      </div>
    </div>
  <% end %>
</div>
