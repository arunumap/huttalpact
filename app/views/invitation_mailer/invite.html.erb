<p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #d97706;">You're Invited</p>
<h1 style="margin: 0 0 24px 0; font-size: 24px; font-weight: 700; color: #111827; line-height: 1.3;">Join <%= @organization.name %> on&nbsp;PactBadger</h1>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 1.6; color: #374151;">
  <strong><%= @inviter.full_name %></strong> has invited you to collaborate on contract management with <strong><%= @organization.name %></strong>.
</p>

<p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.6; color: #374151;">
  Create your account to get started &mdash; it only takes a minute.
</p>

<!-- CTA button -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #d97706;">
      <a href="<%= @accept_url %>" target="_blank" style="display: inline-block; padding: 14px 36px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #d97706;">
        Accept Invitation &#8594;
      </a>
    </td>
  </tr>
</table>

<% if @invitation.expires_at %>
  <p style="margin: 0; font-size: 13px; color: #9ca3af;">
    This invitation expires on <%= l(@invitation.expires_at.to_date, format: :long) %>.
  </p>
<% end %>
