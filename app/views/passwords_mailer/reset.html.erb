<p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #d97706;">Password Reset</p>
<h1 style="margin: 0 0 24px 0; font-size: 24px; font-weight: 700; color: #111827; line-height: 1.3;">Reset your password</h1>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 1.6; color: #374151;">
  We received a request to reset the password for your HuttalPact account. Click the button below to choose a new password.
</p>

<!-- CTA button -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #d97706;">
      <a href="<%= edit_password_url(@user.password_reset_token) %>" target="_blank" style="display: inline-block; padding: 14px 36px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #d97706;">
        Reset Password &#8594;
      </a>
    </td>
  </tr>
</table>

<p style="margin: 0 0 8px 0; font-size: 13px; color: #9ca3af;">
  This link will expire in <%= distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>.
</p>
<p style="margin: 0; font-size: 13px; color: #9ca3af;">
  If you didn&rsquo;t request this, you can safely ignore this email.
</p>
