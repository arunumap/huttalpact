<% content_for :title, @solution.meta_title %>
<% content_for :meta_description, @solution.meta_description %>
<% content_for :canonical_url, solution_url(@solution.slug) %>

<%= structured_data(type: :organization) %>
<%= structured_data(type: :software_application) %>

<section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-amber-50/30 to-orange-50/20 pt-16 pb-24 sm:pt-24 sm:pb-32" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid opacity-40"></div>
  <div class="absolute top-0 right-0 h-[600px] w-[600px] rounded-full bg-gradient-to-bl from-amber-200/20 via-orange-100/10 to-transparent blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-800 ring-1 ring-amber-200/60 backdrop-blur-sm">
          <%= @solution.hero_eyebrow %>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.1]">
          <%= @solution.hero_title %>
        </h1>

        <p class="mt-6 text-lg leading-8 text-gray-600">
          <%= @solution.hero_description %>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <%= link_to "Start Free", new_registration_path,
              class: "rounded-full bg-gray-900 px-6 py-3 text-base font-semibold text-white shadow-lg hover:bg-gray-800 hover:shadow-xl transition-all duration-200" %>
          <%= link_to "All Solutions", solutions_path,
              class: "rounded-full border border-gray-300 bg-white/70 backdrop-blur-sm px-6 py-3 text-base font-semibold text-gray-700 hover:bg-white hover:border-gray-400 transition-all duration-200" %>
        </div>

        <p class="mt-4 text-sm text-gray-500">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
      </div>

      <div class="relative animate-on-scroll">
        <div class="screenshot-3d overflow-hidden rounded-xl shadow-2xl ring-1 ring-gray-200/50">
          <%= image_tag "screenshots/clauses-illustration.svg",
              alt: "PactBadger #{@solution.name.downcase} extraction view",
              class: "w-full",
              loading: "eager" %>
        </div>

        <div class="absolute -bottom-4 -left-4 sm:-left-6 rounded-xl bg-white/90 px-4 py-3 shadow-lg ring-1 ring-gray-200/60 backdrop-blur-md">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-green-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= @solution.hero_badge_title %></p>
              <p class="text-xs text-gray-500"><%= @solution.hero_badge_text %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-gray-950 py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Why this matters",
        title: @solution.pain_title,
        subtitle: @solution.pain_subtitle,
        dark: true %>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% @solution.pain_points.each_with_index do |item, index| %>
        <div class="glass-card-dark p-6 animate-on-scroll stagger-delay-<%= (index % 4) + 1 %>">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
            <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-white"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-400"><%= item[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-white py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Core Features",
        title: @solution.feature_title,
        subtitle: @solution.feature_subtitle %>

    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% @solution.features.each_with_index do |feature, index| %>
        <%= render "shared/feature_card",
            icon: SolutionCatalog.feature_icon(index),
            title: feature[:title],
            description: feature[:description],
            delay_class: "stagger-delay-#{(index % 3) + 1}" %>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-gray-50 py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "How It Works",
        title: @solution.steps_title,
        subtitle: @solution.steps_subtitle %>

    <div class="mt-20 space-y-24">
      <% @solution.steps.each_with_index do |step, index| %>
        <% image_path = index == 0 ? "screenshots/upload-illustration.svg" : (index == 1 ? "screenshots/clauses-illustration.svg" : "screenshots/alerts-illustration.svg") %>
        <% image_alt = index == 0 ? "Upload contract files to PactBadger" : (index == 1 ? "AI-extracted contract terms in PactBadger" : "Contract deadline alerts in PactBadger") %>
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16 animate-on-scroll">
          <div class="<%= 'order-2 lg:order-1' if index.odd? %>">
            <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
              Step <%= index + 1 %>
            </div>
            <h3 class="mt-4 text-2xl font-bold text-gray-900 sm:text-3xl"><%= step[:title] %></h3>
            <p class="mt-4 text-lg leading-8 text-gray-600"><%= step[:description] %></p>
          </div>

          <div class="<%= 'order-1 lg:order-2' if index.odd? %> overflow-hidden rounded-xl shadow-xl ring-1 ring-gray-200/50">
            <%= image_tag image_path, alt: image_alt, class: "w-full", loading: "lazy" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-white py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Why Switch",
        title: "PactBadger vs. the alternatives".html_safe,
        subtitle: @solution.comparison_subtitle %>

    <div class="mt-12 overflow-hidden rounded-xl ring-1 ring-gray-200 animate-on-scroll">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-gray-50">
            <th class="px-6 py-4 text-left font-semibold text-gray-900">Capability</th>
            <th class="px-6 py-4 text-center font-semibold text-gray-400">Spreadsheets</th>
            <th class="px-6 py-4 text-center font-semibold text-gray-400">Calendar</th>
            <th class="bg-amber-50/50 px-6 py-4 text-center font-semibold text-amber-700">PactBadger</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @solution.comparison_rows.each do |row| %>
            <tr>
              <td class="px-6 py-3.5 font-medium text-gray-900"><%= row[0] %></td>
              <% [1, 2, 3].each do |column| %>
                <td class="px-6 py-3.5 text-center <%= column == 3 ? 'bg-amber-50/30' : '' %>">
                  <% if row[column] == true %>
                    <svg class="mx-auto h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                    </svg>
                  <% elsif row[column] == false %>
                    <svg class="mx-auto h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                    </svg>
                  <% else %>
                    <span class="text-xs text-gray-400"><%= row[column] %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="relative overflow-hidden bg-gray-950 py-20 sm:py-24">
  <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>
  <div class="absolute inset-0 bg-grid opacity-10"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl"><%= @solution.cta_title %></h2>
    <p class="mt-4 text-lg text-gray-300"><%= @solution.cta_description %></p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <%= link_to "Start Free", new_registration_path,
          class: "rounded-full bg-white px-8 py-3.5 text-base font-semibold text-gray-900 shadow-lg hover:bg-gray-100 transition-all duration-200" %>
      <%= link_to "Browse All Solutions", solutions_path,
          class: "rounded-full border border-white/20 bg-white/10 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/20 transition-all duration-200" %>
    </div>
    <p class="mt-6 text-sm text-gray-400">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
  </div>
</section>
