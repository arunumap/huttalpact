</section>

<%# ── How It Works (Alternating Screenshots) ── %>
<section class="bg-gray-50 py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "How It Works",
        title: "From lease document to deadline control",
        subtitle: "Three steps to turn paper leases into a proactive management system." %>

    <div class="mt-20 space-y-24">
      <%# Step 1 %>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center animate-on-scroll">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
            Step 1
          </div>
          <h3 class="mt-4 text-2xl font-bold text-gray-900 sm:text-3xl">Upload your lease documents</h3>
          <p class="mt-4 text-lg leading-8 text-gray-600">
            Drag and drop PDF, Word, or scanned lease files. PactBadger accepts any format and
            extracts text automatically. Keep all lease documents organized in one place.
          </p>
          <ul class="mt-6 space-y-3">
            <% ["PDF, DOCX, TXT, and image formats", "Multiple documents per lease", "Secure cloud storage with encryption"].each do |item| %>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <svg class="h-5 w-5 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                <%= item %>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="rounded-xl shadow-xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/upload.png",
              alt: "Upload lease documents to PactBadger",
              class: "w-full",
              loading: "lazy" %>
        </div>
      </div>

      <%# Step 2 %>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center animate-on-scroll">
        <div class="order-2 lg:order-1 rounded-xl shadow-xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/clauses-illustration.svg",
              alt: "AI-extracted lease clauses and data fields",
              class: "w-full",
              loading: "lazy" %>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
            Step 2
          </div>
          <h3 class="mt-4 text-2xl font-bold text-gray-900 sm:text-3xl">AI extracts every detail</h3>
          <p class="mt-4 text-lg leading-8 text-gray-600">
            Our AI reads the entire lease and populates 40+ structured fields: rent amounts,
            escalation schedules, CAM provisions, option windows, and critical dates. Then you
            review and confirm.
          </p>
          <ul class="mt-6 space-y-3">
            <% ["40+ lease-specific data points", "Human-in-the-loop review workflow", "Evidence-backed extractions with source quotes"].each do |item| %>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <svg class="h-5 w-5 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                <%= item %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# Step 3 %>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center animate-on-scroll">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
            Step 3
          </div>
          <h3 class="mt-4 text-2xl font-bold text-gray-900 sm:text-3xl">Stay ahead of every deadline</h3>
          <p class="mt-4 text-lg leading-8 text-gray-600">
            PactBadger monitors all your lease dates and sends proactive alerts before deadlines
            arrive. Your dashboard shows upcoming expirations, option windows, and action items
            at a glance.
          </p>
          <ul class="mt-6 space-y-3">
            <% ["30/14/7-day advance email alerts", "Dashboard with upcoming deadlines", "Team notifications for critical dates"].each do |item| %>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <svg class="h-5 w-5 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                <%= item %>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="rounded-xl shadow-xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/alerts.png",
              alt: "PactBadger lease deadline alerts dashboard",
              class: "w-full",
              loading: "lazy" %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Comparison Table ── %>
<section class="bg-white py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Why Switch",
        title: "PactBadger vs. the alternatives",
        subtitle: "See how a purpose-built lease tool compares to manual methods." %>

    <div class="mt-12 overflow-hidden rounded-xl ring-1 ring-gray-200 animate-on-scroll">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-gray-50">
            <th class="px-6 py-4 text-left font-semibold text-gray-900">Capability</th>
            <th class="px-6 py-4 text-center font-semibold text-gray-400">Spreadsheets</th>
            <th class="px-6 py-4 text-center font-semibold text-gray-400">Calendar</th>
            <th class="px-6 py-4 text-center font-semibold text-amber-700 bg-amber-50/50">PactBadger</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% [
            ["AI document extraction", false, false, true],
            ["Structured lease data fields", false, false, true],
            ["Rent schedule tracking", "Manual", false, true],
            ["CAM & operating terms", "Manual", false, true],
            ["Option & notice tracking", "Manual", "Basic", true],
            ["Milestone management", false, "Basic", true],
            ["Automated deadline alerts", false, "Basic", true],
            ["Multi-user collaboration", "Limited", "Basic", true],
            ["Document storage", false, false, true],
            ["Audit trail", false, false, true],
          ].each do |row| %>
            <tr>
              <td class="px-6 py-3.5 font-medium text-gray-900"><%= row[0] %></td>
              <% [1, 2, 3].each do |col| %>
                <td class="px-6 py-3.5 text-center <%= col == 3 ? 'bg-amber-50/30' : '' %>">
                  <% if row[col] == true %>
                    <svg class="mx-auto h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                  <% elsif row[col] == false %>
                    <svg class="mx-auto h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
                  <% else %>
                    <span class="text-gray-400 text-xs"><%= row[col] %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# ── CTA Section ── %>
<section class="relative bg-gray-950 py-20 sm:py-24 overflow-hidden" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>
  <div class="absolute inset-0 bg-grid opacity-10"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8 animate-on-scroll">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Get control of your lease deadlines
    </h2>
    <p class="mt-4 text-lg text-gray-300">
      Start free and see how quickly your team can move from paper leases to proactive deadline management.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <%= link_to "Start Free", new_registration_path,
          class: "rounded-full bg-white px-8 py-3.5 text-base font-semibold text-gray-900 shadow-lg hover:bg-gray-100 transition-all duration-200" %>
      <%= link_to "See Pricing", pricing_path,
          class: "rounded-full border border-white/20 bg-white/10 backdrop-blur-sm px-8 py-3.5 text-base font-semibold text-white hover:bg-white/20 transition-all duration-200" %>
    </div>
    <p class="mt-6 text-sm text-gray-400">No credit card required. Free plan includes 10 leases.</p>
  </div>
</section>
