<% content_for :title, "Lease Management Software — AI Extraction & Deadline Alerts | PactBadger" %>
<% content_for :meta_description, "PactBadger turns lease documents into structured data with AI extraction. Track rent schedules, CAM terms, options, milestones, and get proactive alerts before deadlines." %>
<% content_for :canonical_url, leases_url %>

<%= structured_data(type: :organization) %>
<%= structured_data(type: :software_application) %>

<%# ── Hero Section ── %>
<section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-amber-50/30 to-orange-50/20 pt-16 pb-24 sm:pt-24 sm:pb-32" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid opacity-40"></div>
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-amber-200/20 via-orange-100/10 to-transparent rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <%# Left: Copy %>
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-800 ring-1 ring-amber-200/60 backdrop-blur-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
          Built for Lease Teams
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.1]">
          Stop chasing lease deadlines in
          <span class="text-gradient">spreadsheets</span>
        </h1>

        <p class="mt-6 text-lg leading-8 text-gray-600">
          Upload a lease and PactBadger extracts rent schedules, CAM terms, option windows, and
          every critical date. Then it watches deadlines for you and alerts your team before
          anything slips.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <%= link_to "Start Free", new_registration_path,
              class: "rounded-full bg-gray-900 px-6 py-3 text-base font-semibold text-white shadow-lg hover:bg-gray-800 hover:shadow-xl transition-all duration-200" %>
          <%= link_to "See Pricing", pricing_path,
              class: "rounded-full border border-gray-300 bg-white/70 backdrop-blur-sm px-6 py-3 text-base font-semibold text-gray-700 hover:bg-white hover:border-gray-400 transition-all duration-200" %>
        </div>
        <p class="mt-4 text-sm text-gray-500">Free plan includes 10 contracts & 5 AI extractions.</p>
      </div>

      <%# Right: Screenshot %>
      <div class="animate-on-scroll relative">
        <div class="screenshot-3d rounded-xl shadow-2xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/clauses-illustration.svg",
              alt: "PactBadger lease clause extraction view",
              class: "w-full",
              loading: "eager" %>
        </div>
        <%# Floating badge %>
        <div class="absolute -bottom-4 -left-4 sm:-left-6 rounded-xl bg-white/90 backdrop-blur-md shadow-lg ring-1 ring-gray-200/60 px-4 py-3 animate-on-scroll-scale">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-green-100 text-green-600">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">40+ fields extracted</p>
              <p class="text-xs text-gray-500">From a single lease upload</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Pain Points Section (Dark) ── %>
<section class="bg-gray-950 py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center animate-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Why lease teams lose money
      </h2>
      <p class="mt-4 text-lg text-gray-400">
        These problems cost property managers thousands every year. Sound familiar?
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { icon: "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z",
           title: "Data buried in PDFs",
           desc: "Key dates and terms are locked inside 50-page lease documents." },
        { icon: "M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z",
           title: "Scattered spreadsheets",
           desc: "Every team member has a different file. No single source of truth." },
        { icon: "M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0",
           title: "Missed notice windows",
           desc: "A single missed renewal notice can cost $50K+ in unfavorable terms." },
        { icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
           title: "Manual date tracking",
           desc: "Calendar reminders and sticky notes are unreliable at scale." }
      ].each_with_index do |item, i| %>
        <div class="glass-card-dark p-6 animate-on-scroll stagger-delay-<%= i + 1 %>">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/20">
            <svg class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-white"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-400"><%= item[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Features Section ── %>
<section class="bg-white py-20 sm:py-24" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Lease Features",
        title: "Everything your lease team needs",
        subtitle: "From document upload to deadline action, PactBadger handles the full lease lifecycle." %>

    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        { icon: "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z",
           title: "AI Lease Extraction",
           desc: "Upload PDF, DOCX, or image files. AI reads the document and extracts 40+ fields including rent, dates, CAM terms, and option clauses." },
        { icon: "M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z",
           title: "Rent Schedules & Escalations",
           desc: "Track effective rent periods, escalation types (fixed, CPI, percentage), and see current vs. upcoming rent changes at a glance." },
        { icon: "M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605",
           title: "CAM & Operating Terms",
           desc: "Capture base year, caps, reconciliation timing, audit rights, and key expense provisions in structured, searchable fields." },
        { icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z",
