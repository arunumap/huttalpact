<% content_for :title, "PactBadger — Contract Intelligence Platform | AI Extraction, Review & Alerts" %>
<% content_for :meta_description, "PactBadger is the contract intelligence platform that extracts key terms with AI, surfaces hidden obligations, and alerts your team before deadlines slip." %>
<% content_for :canonical_url, root_url %>

<%= structured_data(type: :organization) %>
<%= structured_data(type: :software_application) %>
<%= structured_data(type: :how_to,
    name: "How to track contract deadlines with PactBadger",
    steps: [
      { name: "Upload your contracts", text: "Drag and drop PDF, Word, or scanned contract files into PactBadger. Supports all common document formats." },
      { name: "AI extracts the details", text: "PactBadger's AI reads each document and extracts 40+ data points including dates, values, parties, clauses, and renewal terms." },
      { name: "Review and confirm", text: "Review AI-extracted data in a guided review workflow. Confirm, edit, or flag items that need attention." },
      { name: "Stay ahead of deadlines", text: "PactBadger monitors all your contract dates and sends proactive email and in-app alerts 30, 14, and 7 days before deadlines." }
    ]) %>

<%# ===== HERO ===== %>
<section class="relative overflow-hidden bg-white" data-controller="scroll-animate">
  <%# Background decoration %>
  <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
  <div class="absolute inset-0 bg-grid opacity-40"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-24 sm:pt-24 sm:pb-32">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <%# Left — copy %>
      <div class="max-w-xl">
        <div class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200/60 mb-6 animate-on-scroll">
          <svg class="mr-1.5 h-3.5 w-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          Contract intelligence platform
        </div>

        <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl lg:text-7xl leading-[1.05] animate-on-scroll stagger-1">
          Your contracts have <span class="text-gradient">hidden deadlines.</span> We find them.
        </h1>

        <p class="mt-6 text-lg leading-8 text-gray-600 animate-on-scroll stagger-2">
          Upload leases, vendor agreements, MSAs, NDAs, amendments, and more — AI extracts every critical date,
          clause, and obligation in seconds. Get automated alerts so your team never misses a renewal, notice
          window, or compliance deadline again.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4 animate-on-scroll stagger-3">
          <%= link_to "Start Free — No Credit Card", new_registration_path,
              class: "rounded-full bg-gray-900 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-gray-900/20 hover:bg-gray-800 hover:shadow-xl hover:shadow-gray-900/25 transition-all duration-200" %>
          <%= link_to pricing_path, class: "group flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-gray-900 transition-colors" do %>
            See Pricing
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          <% end %>
        </div>

        <p class="mt-4 text-sm text-gray-500 animate-on-scroll stagger-4">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
      </div>

      <%# Right — product screenshot with 3D effect %>
      <div class="relative animate-on-scroll-scale stagger-2">
        <div class="screenshot-3d rounded-xl shadow-2xl ring-1 ring-gray-900/10 overflow-hidden glow-amber">
          <%= image_tag "screenshots/dashboard-illustration.svg",
              alt: "PactBadger dashboard showing contract overview with AI-extracted dates, renewal alerts, and spend tracking",
              class: "w-full",
              loading: "eager" %>
        </div>

        <%# Floating badges %>
        <div class="absolute -top-3 -right-3 hidden lg:flex items-center gap-2 rounded-full bg-white px-3 py-1.5 shadow-lg ring-1 ring-gray-200/50 text-xs font-semibold text-gray-700">
          <span class="flex h-2 w-2 rounded-full bg-green-500"></span>
          AI extracts 40+ fields
        </div>
        <div class="absolute -bottom-3 -left-3 hidden lg:flex items-center gap-2 rounded-full bg-white px-3 py-1.5 shadow-lg ring-1 ring-gray-200/50 text-xs font-semibold text-gray-700">
          <svg class="h-3.5 w-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
          Alerts 30+ days early
        </div>
      </div>
    </div>
  </div>
</section>


<%# ===== STATS BAR ===== %>
<section class="relative border-y border-gray-200/50 bg-gray-50/50" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="text-center animate-on-scroll">
        <p class="text-3xl font-bold text-gray-900">
          <span data-controller="counter" data-counter-target-value="40" data-counter-suffix-value="+">0</span>
        </p>
        <p class="mt-1 text-sm text-gray-500">Data points extracted per contract</p>
      </div>
      <div class="text-center animate-on-scroll stagger-1">
        <p class="text-3xl font-bold text-gray-900">
          &lt;<span data-controller="counter" data-counter-target-value="60">0</span>s
        </p>
        <p class="mt-1 text-sm text-gray-500">Average extraction time</p>
      </div>
      <div class="text-center animate-on-scroll stagger-2">
        <p class="text-3xl font-bold text-gray-900">
          <span data-controller="counter" data-counter-target-value="30">0</span>+
        </p>
        <p class="mt-1 text-sm text-gray-500">Days advance notice on deadlines</p>
      </div>
      <div class="text-center animate-on-scroll stagger-3">
        <p class="text-3xl font-bold text-gray-900">
          <span data-controller="counter" data-counter-target-value="95" data-counter-suffix-value="%">0</span>
        </p>
        <p class="mt-1 text-sm text-gray-500">Key clause detection accuracy</p>
      </div>
    </div>
  </div>
</section>

<%# ===== THE PROBLEM ===== %>
<section class="relative overflow-hidden bg-gray-950 py-20 sm:py-28" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid-dark"></div>
  <div class="absolute inset-0 bg-mesh-gradient-dark"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "The Problem",
        title: "Teams lose leverage when contract deadlines slip".html_safe,
        subtitle: "Most teams track renewals in spreadsheets, set reminders manually, or just hope someone remembers. Here\u2019s what that costs you.",
        dark: true %>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl p-6 glass-card-dark animate-on-scroll hover-lift">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
          <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-white">Unwanted Auto-Renewals</h3>
        <p class="mt-2 text-sm text-gray-400">Locked into bad terms for another year because nobody caught the 60-day notice window.</p>
      </div>

      <div class="rounded-2xl p-6 glass-card-dark animate-on-scroll stagger-1 hover-lift">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
          <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-white">Lost Negotiation Leverage</h3>
        <p class="mt-2 text-sm text-gray-400">Contracts expire before you start shopping alternatives. Vendors know you have no leverage.</p>
      </div>

      <div class="rounded-2xl p-6 glass-card-dark animate-on-scroll stagger-2 hover-lift">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
          <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" /></svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-white">Spreadsheets Go Stale</h3>
        <p class="mt-2 text-sm text-gray-400">Your tracking sheet is outdated the moment it's saved. New agreements, amendments, and changes pile up.</p>
      </div>

      <div class="rounded-2xl p-6 glass-card-dark animate-on-scroll stagger-3 hover-lift">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
          <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-white">Operational Surprises</h3>
        <p class="mt-2 text-sm text-gray-400">Compliance dates, price changes, approvals, and renewal windows catch you off guard.</p>
      </div>
    </div>
  </div>
</section>

<%# ===== FEATURES ===== %>
<section class="relative bg-white py-20 sm:py-28" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "Contract Intelligence",
        title: "One system for every contract deadline".html_safe,
        subtitle: "Upload your documents. AI does the rest. No more spreadsheets, no more calendar guesswork." %>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <%= render "shared/feature_card",
          icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />',
