<%# ===== HOW IT WORKS ===== %>
<section class="relative bg-gray-50 py-20 sm:py-28 overflow-hidden" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-dots opacity-50"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "How it works",
        title: "From document to deadline tracking in under two minutes".html_safe,
        subtitle: "Three steps. No training required. No implementation consultants." %>

    <%# Step 1 %>
    <div class="mt-20 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="animate-on-scroll-left">
        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white shadow-lg shadow-amber-500/20">1</div>
        <h3 class="mt-4 text-2xl font-bold text-gray-900">Upload your contracts</h3>
        <p class="mt-3 text-base leading-7 text-gray-600">
          Drop in PDFs, Word docs, or text files — leases, vendor agreements, service contracts.
          Drag and drop or browse. PactBadger accepts whatever format your contracts are in.
        </p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            PDF, DOCX, and TXT formats supported
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Drag and drop or browse to upload
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Attach multiple documents per contract
          </li>
        </ul>
      </div>
      <div class="animate-on-scroll-right">
        <div class="rounded-xl shadow-2xl ring-1 ring-gray-900/10 overflow-hidden">
          <%= image_tag "screenshots/upload.png",
              alt: "Contract upload interface showing drag and drop file upload",
              class: "w-full",
              loading: "lazy" %>
        </div>
      </div>
    </div>

    <%# Step 2 %>
    <div class="mt-24 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1 animate-on-scroll-left">
        <div class="rounded-xl shadow-2xl ring-1 ring-gray-900/10 overflow-hidden">
          <%= image_tag "screenshots/clauses-illustration.svg",
              alt: "AI-extracted contract data showing key clauses, dates, and values with confidence scores",
              class: "w-full",
              loading: "lazy" %>
        </div>
      </div>
      <div class="order-1 lg:order-2 animate-on-scroll-right">
        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white shadow-lg shadow-amber-500/20">2</div>
        <h3 class="mt-4 text-2xl font-bold text-gray-900">AI extracts every detail</h3>
        <p class="mt-3 text-base leading-7 text-gray-600">
          Our AI reads each contract end-to-end and pulls out dates, dollar amounts, vendor names, renewal terms,
          termination clauses, rent schedules, and more. Review and confirm — it's that simple.
        </p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            40+ data points extracted per contract
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Confidence scores on every extraction
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Human-in-the-loop review workflow
          </li>
        </ul>
      </div>
    </div>

    <%# Step 3 %>
    <div class="mt-24 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="animate-on-scroll-left">
        <div class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white shadow-lg shadow-amber-500/20">3</div>
        <h3 class="mt-4 text-2xl font-bold text-gray-900">Get alerts before every deadline</h3>
        <p class="mt-3 text-base leading-7 text-gray-600">
          PactBadger monitors every contract and sends email and in-app alerts well before renewals, expirations,
          and notice periods close. Your team gets time to act, not scramble.
        </p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Configurable alert windows (30, 60, 90 days)
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="h-4 w-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Email and in-app notifications
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
