<%# ===== PRICING TEASER ===== %>
<section class="bg-white py-20 sm:py-28" data-controller="scroll-animate">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        title: "Simple, transparent pricing".html_safe,
        subtitle: "Start free. Upgrade when you need more. No surprises." %>

    <% card_grid_classes = case @plan_tiers.size
       when 1 then ""
       when 2 then "sm:grid-cols-2"
       when 3 then "sm:grid-cols-3"
       else "sm:grid-cols-2 xl:grid-cols-4"
       end %>
    <div class="mt-14 grid grid-cols-1 gap-6 <%= card_grid_classes %>">
      <% @plan_tiers.each_with_index do |tier, idx| %>
        <% card_ring = tier.featured? ? "ring-2 ring-amber-500 shadow-lg shadow-amber-500/10" : "ring-1 ring-gray-200" %>
        <% contracts_text = tier.contract_limit.present? ? "#{tier.contract_limit} contracts" : "Unlimited contracts" %>
        <% extractions_text = tier.extraction_limit.present? ? "#{tier.extraction_limit} AI extractions" : "Unlimited AI extractions" %>
        <% users_text = tier.user_limit.present? ? "#{tier.user_limit} users" : "Unlimited users" %>

        <div class="relative rounded-2xl bg-white p-8 <%= card_ring %> text-center hover-lift animate-on-scroll stagger-<%= idx + 1 %>">
          <% if tier.featured? %>
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-4 py-1 text-xs font-semibold text-white shadow-sm">Most Popular</span>
          <% end %>

          <h3 class="text-lg font-semibold text-gray-900"><%= tier.name %></h3>
          <p class="mt-4 text-4xl font-bold text-gray-900"><%= number_to_currency(tier.monthly_price_cents.to_f / 100.0, precision: 0) %><span class="text-base font-normal text-gray-500">/mo</span></p>
          <p class="mt-3 text-sm text-gray-500"><%= [contracts_text, extractions_text, users_text].join(" \u00b7 ") %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-10 text-center animate-on-scroll">
      <%= link_to pricing_path, class: "group inline-flex items-center gap-2 text-sm font-semibold text-amber-600 hover:text-amber-500 transition-colors" do %>
        View full pricing details
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      <% end %>
    </div>
  </div>
</section>

