<% content_for :title, "PactBadger — Track Contracts and Never Miss a Renewal" %>
<% content_for :meta_description, "Stop tracking contracts in spreadsheets. Upload contracts, extract key dates with AI, and get alerts before deadlines. Start free." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :canonical_url, ads_contracts_landing_url %>

<% signup_path = new_registration_path(@ads_signup_params || {}) %>

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-amber-600">Built for busy teams</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Stop missing contract deadlines
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        PactBadger helps you centralize contracts, auto-extract key terms, and get proactive alerts before renewals and expirations.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <%= link_to "Get Started Free", signup_path,
            class: "rounded-lg bg-amber-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-amber-500 transition" %>
        <%= link_to "See Pricing", pricing_path,
            class: "rounded-lg border border-gray-300 px-6 py-3 text-base font-semibold text-gray-700 hover:bg-gray-50 transition" %>
      </div>
      <p class="mt-4 text-sm text-gray-500">Free plan includes 10 contracts and 5 AI extractions per billing period. No credit card required.</p>
    </div>
  </div>
</section>

<section class="bg-gray-50 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">AI extraction in seconds</h2>
        <p class="mt-2 text-sm leading-6 text-gray-600">Upload PDF, DOCX, or TXT contracts and automatically capture dates, values, and key clauses.</p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Deadlines you can trust</h2>
        <p class="mt-2 text-sm leading-6 text-gray-600">Get in-app and email alerts before renewals, expirations, and notice windows so nothing slips through.</p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Visibility for your team</h2>
        <p class="mt-2 text-sm leading-6 text-gray-600">See contracts, spend, revenue, and upcoming deadlines in one place instead of scattered spreadsheets.</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-gray-900 px-8 py-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Start tracking contracts with confidence</h2>
      <p class="mt-4 text-lg text-gray-300">Create your free account and upload your first contract in minutes.</p>
      <div class="mt-8">
        <%= link_to "Create Free Account", signup_path,
            class: "inline-flex items-center rounded-lg bg-amber-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-amber-500 transition" %>
      </div>
    </div>
  </div>
</section>
