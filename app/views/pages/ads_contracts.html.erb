<% content_for :title, "PactBadger — AI Contract Extraction & Deadline Tracking" %>
<% content_for :meta_description, "Use PactBadger to extract key dates from contracts with AI, review the results, and stay ahead of renewals, obligations, and notice windows." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :canonical_url, ads_contracts_landing_url %>

<% content_for :head do %>
  <% if Rails.env.production? %>
    <script>
      function gtagSendEvent(url) {
        var callback = function () {
          if (typeof url === 'string') { window.location = url; }
        };
        gtag('event', 'conversion_event_signup', {
          'event_callback': callback,
          'event_timeout': 2000,
        });
        return false;
      }
    </script>
  <% end %>
<% end %>

<% signup_params = @ads_signup_params || {} %>
<% dmm_term = @dmm_term %>
<% hero_headline = dmm_term.present? ? "Stay ahead of #{dmm_term.downcase} with AI contract intelligence" : "Never miss a critical contract deadline again" %>
<% hero_subheadline = if dmm_term.present?
  "The risk is not the contract itself — it is the deadline your team does not see until it is too late. PactBadger helps teams stay ahead of #{dmm_term.downcase} with AI extraction, guided review, and proactive alerts."
else
  "Deadlines get missed when they are buried in PDFs, scattered across spreadsheets, and owned by no one. PactBadger gives your team one place to extract, review, and track renewals, notice periods, obligations, and expiration dates before they become expensive surprises."
end %>

<%# ── Hero + Signup Form ── %>
<section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-amber-50/30 to-orange-50/20 py-14 sm:py-20" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-bl from-amber-200/20 via-orange-100/10 to-transparent rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
      <%# Left: Copy + Screenshot %>
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-800 ring-1 ring-amber-200/60 backdrop-blur-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
          AI contract intelligence
        </div>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl leading-[1.1]"><%= hero_headline %></h1>
        <p class="mt-5 text-lg leading-8 text-gray-600"><%= hero_subheadline %></p>

        <ul class="mt-6 space-y-3">
          <% [
            "Deadlines hidden in PDFs, amendments, and email threads",
            "Spreadsheets and calendar reminders that break as contracts pile up",
            "Last-minute renewal scrambles that cost leverage, time, and money"
          ].each do |item| %>
            <li class="flex items-center gap-3 text-sm text-gray-700">
              <svg class="h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
              <%= item %>
            </li>
          <% end %>
        </ul>

        <div class="mt-8 rounded-xl shadow-xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/dashboard-illustration.svg",
              alt: "PactBadger dashboard with upcoming contract deadlines",
              class: "w-full",
              loading: "eager" %>
        </div>
      </div>

      <%# Right: Signup Form %>
      <div id="signup" class="rounded-2xl bg-white/80 backdrop-blur-md p-6 shadow-xl ring-1 ring-gray-200/60 sm:p-8 lg:sticky lg:top-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900">Create your free account</h2>
        <p class="mt-2 text-sm text-gray-600">Start managing contract deadlines in minutes. No credit card required.</p>

        <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4",
              html: {} do |form| %>
          <% signup_params.each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>

          <% if @user.errors.any? %>
            <div class="rounded-lg bg-red-50 p-3 ring-1 ring-red-200/60">
              <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :first_name, autocomplete: "given-name",
                  class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
            <div>
              <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :last_name, autocomplete: "family-name",
                  class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= label_tag "user_organization_name", "Company / Organization name", class: "block text-sm font-medium text-gray-700" %>
            <%= text_field_tag "user[organization_name]", @organization_name,
                autocomplete: "organization",
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Your company" %>
          </div>

          <div>
            <%= form.label :email_address, "Work email", class: "block text-sm font-medium text-gray-700" %>
            <%= form.email_field :email_address, required: true, autocomplete: "email",
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "you@company.com" %>
          </div>

          <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "At least 8 characters" %>
          </div>

          <div>
            <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Confirm your password" %>
          </div>

          <div class="flex items-start gap-3">
            <%= form.check_box :terms_accepted, class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-600 cursor-pointer" %>
            <%= form.label :terms_accepted, class: "text-sm text-gray-600 cursor-pointer" do %>
              I agree to the <%= link_to "Terms of Use", terms_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %> and <%= link_to "Privacy Policy", privacy_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %>
            <% end %>
          </div>

          <div class="space-y-3">
            <%= form.submit "Create Free Account",
                data: { turbo_submits_with: "Creating account..." },
                class: "flex w-full justify-center rounded-xl bg-gray-900 px-4 py-3 text-sm font-semibold text-white shadow-lg hover:bg-gray-800 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer transition-all duration-200" %>
            <p class="text-center text-sm text-gray-500">
              Already have an account?
              <%= link_to "Sign in", new_session_path, class: "font-medium text-amber-600 hover:text-amber-500" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── Problem Section ── %>
<section class="bg-gray-950 py-16 sm:py-20" data-controller="scroll-animate">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center animate-on-scroll">
      <div class="inline-flex items-center rounded-full bg-amber-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-400">
        The Problem
      </div>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        The contracts are not the problem. The invisible deadlines are.
      </h2>
      <p class="mt-4 text-lg text-gray-400">
        Teams do not lose money because they do not care. They lose money because key dates are buried in legal language,
        scattered across spreadsheets, and surfaced only when the deadline is already too close.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      <% [
        { title: "Auto-renewals sneak through", desc: "By the time someone notices the notice window, the contract has already rolled forward on bad terms." },
        { title: "Spreadsheets drift out of date", desc: "A shared tracker is wrong the moment a new agreement, amendment, or renewal is signed." },
        { title: "No one clearly owns the deadline", desc: "Legal, operations, procurement, and finance each assume someone else is watching the contract." },
        { title: "Everything becomes a fire drill", desc: "Instead of acting early, the team scrambles at the last minute with less leverage and more risk." }
      ].each_with_index do |item, i| %>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm animate-on-scroll stagger-delay-<%= i + 1 %>">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
            <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-white"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-400"><%= item[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── How It Works ── %>
<section class="bg-white py-16 sm:py-20" data-controller="scroll-animate">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center animate-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">From document to deadline tracking in 2 minutes</h2>
      <p class="mt-4 text-lg text-gray-600">Three steps. No training required.</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      <% [
        { step: "1", title: "Upload a contract", desc: "Drop in your document. PactBadger accepts PDF, Word, and scanned files.", img: "screenshots/upload-illustration.svg", alt: "Upload interface" },
        { step: "2", title: "AI extracts key contract terms", desc: "Renewal windows, notice periods, obligations, clauses, and 40+ more fields.", img: "screenshots/clauses-illustration.svg", alt: "AI extraction results" },
        { step: "3", title: "Alerts keep your team ahead", desc: "Get email and in-app reminders before deadlines so nothing slips.", img: "screenshots/alerts-illustration.svg", alt: "Alert notifications" }
      ].each_with_index do |item, i| %>
        <div class="glass-card p-6 animate-on-scroll stagger-delay-<%= i + 1 %>">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white"><%= item[:step] %></div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-600"><%= item[:desc] %></p>
          <div class="mt-4 overflow-hidden rounded-lg ring-1 ring-gray-200/50">
            <%= image_tag item[:img], alt: item[:alt], class: "w-full", loading: "lazy" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Case Study ── %>
<section class="bg-gray-50 py-16 sm:py-20" data-controller="scroll-animate">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 animate-on-scroll">
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-200/60 overflow-hidden">
      <div class="border-b border-amber-200/60 bg-gradient-to-r from-amber-50 to-orange-50 px-6 py-4 sm:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-700">Example Scenario</p>
        <h2 class="mt-1 text-xl font-bold text-gray-900">How one operations team got control of 87 contract deadlines</h2>
      </div>
      <div class="p-6 sm:p-8">
        <p class="text-base leading-7 text-gray-600">
          An operations team managing supplier agreements, customer amendments, and service contracts was tracking
          deadlines in a shared spreadsheet and calendar reminders. They uploaded 87 contracts to PactBadger and
          within the first week surfaced three upcoming auto-renewals they had not been tracking before the team was forced into another last-minute scramble.
        </p>

        <div class="mt-8 grid grid-cols-3 gap-4">
          <% [
            { label: "Day 1", value: "87", desc: "Contracts uploaded" },
            { label: "Day 3", value: "3", desc: "Missed renewals found" },
            { label: "Day 7", value: "1", desc: "Spreadsheet retired" }
          ].each do |stat| %>
            <div class="rounded-xl bg-gray-50 p-4 text-center ring-1 ring-gray-200/50">
              <p class="text-xs font-semibold uppercase tracking-wide text-amber-600"><%= stat[:label] %></p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900"><%= stat[:value] %></p>
              <p class="mt-1 text-xs text-gray-500"><%= stat[:desc] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Security & Trust ── %>
<section class="bg-white py-14 sm:py-16" data-controller="scroll-animate">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center animate-on-scroll">
      <div class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gray-600">
        Security & Trust
      </div>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Your documents deserve serious protection</h2>
      <p class="mt-3 text-base text-gray-600">Contracts contain sensitive data. Here is how we keep it safe.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        { icon: "lock-closed", title: "Encrypted in transit & at rest", desc: "All data is transmitted over TLS-encrypted connections. Documents and database records are also encrypted at rest." },
        { icon: "shield-check", title: "Tenant isolation", desc: "Every organization's data is logically isolated. Your contracts, users, and extractions are never accessible to other accounts." },
        { icon: "finger-print", title: "Audit trail", desc: "Every action — uploads, reviews, changes, and exports — is logged so your team has a complete record of who did what." },
        { icon: "cpu-chip", title: "Responsible AI", desc: "AI extraction is powered by Anthropic's Claude via encrypted API. Your document data is not used for model training." }
      ].each_with_index do |item, i| %>
        <div class="rounded-xl border border-gray-200 bg-gray-50/50 p-5 animate-on-scroll stagger-delay-<%= i + 1 %>">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100">
            <% case item[:icon] %>
            <% when "lock-closed" %>
              <svg class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
            <% when "shield-check" %>
              <svg class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
            <% when "finger-print" %>
              <svg class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0119.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 004.5 10.5a48.667 48.667 0 00-1.395 8.972m-1.605.324A4.504 4.504 0 015.5 15a4.5 4.5 0 014.5 4.5v.164m-2.63-2.073A3 3 0 0110.5 15h.258a3 3 0 012.84 2.041l.037.111m-.54-7.652a7.5 7.5 0 00-7.5 7.5c0 .661.062 1.308.18 1.934m-.362-1.934a48.687 48.687 0 01-.318-3.09A7.517 7.517 0 0112 3c1.655 0 3.198.534 4.447 1.44" /></svg>
            <% when "cpu-chip" %>
              <svg class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" /></svg>
            <% end %>
          </div>
          <h3 class="mt-3 text-sm font-semibold text-gray-900"><%= item[:title] %></h3>
          <p class="mt-1.5 text-sm leading-6 text-gray-600"><%= item[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Bottom CTA ── %>
<section class="relative bg-gray-950 py-16 sm:py-20 overflow-hidden">
  <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>
  <div class="absolute inset-0 bg-grid opacity-10"></div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Start tracking contracts in minutes</h2>
    <p class="mt-4 text-lg text-gray-300">Upload your first contract and let PactBadger extract key dates and create alerts for your team.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <%= link_to "Create Your Free Account", "#signup",
          class: "rounded-full bg-white px-8 py-3.5 text-base font-semibold text-gray-900 shadow-lg hover:bg-gray-100 transition-all duration-200" %>
    </div>
    <p class="mt-4 text-sm text-gray-400">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
  </div>
</section>
