<% content_for :title, "PactBadger for Property Managers — Never Miss Lease or Contract Deadlines" %>
<% content_for :meta_description, "Property managers use PactBadger to track leases and service contracts, extract key dates with AI, and stay ahead of renewals and notice windows." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :canonical_url, ads_contracts_landing_url %>

<% content_for :head do %>
  <% if Rails.env.production? %>
    <script>
      function gtagSendEvent(url) {
        var callback = function () {
          if (typeof url === 'string') { window.location = url; }
        };
        gtag('event', 'conversion_event_signup', {
          'event_callback': callback,
          'event_timeout': 2000,
        });
        return false;
      }
    </script>
  <% end %>
<% end %>

<% signup_params = @ads_signup_params || {} %>
<% dmm_term = @dmm_term %>
<% hero_headline = dmm_term.present? ? "Never miss critical #{dmm_term.downcase} deadlines again" : "Never miss a lease or vendor contract deadline again" %>
<% hero_subheadline = if dmm_term.present?
  "PactBadger helps property management teams stay ahead of #{dmm_term.downcase} deadlines with AI extraction, renewal tracking, and proactive alerts."
else
  "Upload your leases and vendor contracts. PactBadger automatically tracks renewals, notice periods, and expiration dates."
end %>

<%# ── Hero + Signup Form ── %>
<section class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-amber-50/30 to-orange-50/20 py-14 sm:py-20" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-bl from-amber-200/20 via-orange-100/10 to-transparent rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
      <%# Left: Copy + Screenshot %>
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-800 ring-1 ring-amber-200/60 backdrop-blur-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
          For Property Managers
        </div>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl leading-[1.1]"><%= hero_headline %></h1>
        <p class="mt-5 text-lg leading-8 text-gray-600"><%= hero_subheadline %></p>

        <ul class="mt-6 space-y-3">
          <% ["AI extracts key dates from contracts automatically", "Get alerts before renewal and notice periods close", "Keep your entire team aligned on upcoming deadlines"].each do |item| %>
            <li class="flex items-center gap-3 text-sm text-gray-700">
              <svg class="h-5 w-5 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              <%= item %>
            </li>
          <% end %>
        </ul>

        <div class="mt-8 rounded-xl shadow-xl ring-1 ring-gray-200/50 overflow-hidden">
          <%= image_tag "screenshots/dashboard.png",
              alt: "PactBadger dashboard with upcoming contract deadlines",
              class: "w-full",
              loading: "eager" %>
        </div>
      </div>

      <%# Right: Signup Form %>
      <div id="signup" class="rounded-2xl bg-white/80 backdrop-blur-md p-6 shadow-xl ring-1 ring-gray-200/60 sm:p-8 lg:sticky lg:top-24">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900">Create your free account</h2>
        <p class="mt-2 text-sm text-gray-600">Start managing contract deadlines in minutes. No credit card required.</p>

        <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4",
              html: { onsubmit: "if (typeof gtag === 'function') { gtag('event', 'conversion_event_signup'); }" } do |form| %>
          <% signup_params.each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>

          <% if @user.errors.any? %>
            <div class="rounded-lg bg-red-50 p-3 ring-1 ring-red-200/60">
              <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :first_name, autocomplete: "given-name",
                  class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
            <div>
              <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :last_name, autocomplete: "family-name",
                  class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= label_tag "user_organization_name", "Company / Organization name", class: "block text-sm font-medium text-gray-700" %>
            <%= text_field_tag "user[organization_name]", @organization_name,
                autocomplete: "organization",
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Your property management company" %>
          </div>

          <div>
            <%= form.label :email_address, "Work email", class: "block text-sm font-medium text-gray-700" %>
            <%= form.email_field :email_address, required: true, autocomplete: "email",
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "you@company.com" %>
          </div>

          <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "At least 8 characters" %>
          </div>

          <div>
            <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Confirm your password" %>
          </div>

          <div class="flex items-start gap-3">
            <%= form.check_box :terms_accepted, class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-600 cursor-pointer" %>
            <%= form.label :terms_accepted, class: "text-sm text-gray-600 cursor-pointer" do %>
              I agree to the <%= link_to "Terms of Use", terms_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %> and <%= link_to "Privacy Policy", privacy_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %>
            <% end %>
          </div>

          <div class="space-y-3">
            <%= form.submit "Create Free Account",
                data: { turbo_submits_with: "Creating account..." },
                class: "flex w-full justify-center rounded-xl bg-gray-900 px-4 py-3 text-sm font-semibold text-white shadow-lg hover:bg-gray-800 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer transition-all duration-200" %>
            <p class="text-center text-sm text-gray-500">
              Already have an account?
              <%= link_to "Sign in", new_session_path, class: "font-medium text-amber-600 hover:text-amber-500" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── How It Works ── %>
<section class="bg-white py-16 sm:py-20" data-controller="scroll-animate">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center animate-on-scroll">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">From document to deadline tracking in 2 minutes</h2>
      <p class="mt-4 text-lg text-gray-600">Three steps. No training required.</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      <% [
        { step: "1", title: "Upload a lease or vendor agreement", desc: "Drop in your document. PactBadger accepts PDF, Word, and scanned files.", img: "screenshots/upload.png", alt: "Upload interface" },
        { step: "2", title: "AI extracts key contract terms", desc: "Renewal windows, notice periods, rent schedules, and 40+ more fields.", img: "screenshots/clauses-illustration.svg", alt: "AI extraction results" },
        { step: "3", title: "Alerts keep your team ahead", desc: "Get email and in-app reminders before deadlines so nothing slips.", img: "screenshots/alerts.png", alt: "Alert notifications" }
      ].each_with_index do |item, i| %>
        <div class="glass-card p-6 animate-on-scroll stagger-delay-<%= i + 1 %>">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white"><%= item[:step] %></div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-600"><%= item[:desc] %></p>
          <div class="mt-4 overflow-hidden rounded-lg ring-1 ring-gray-200/50">
            <%= image_tag item[:img], alt: item[:alt], class: "w-full", loading: "lazy" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Case Study ── %>
<section class="bg-gray-50 py-16 sm:py-20" data-controller="scroll-animate">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 animate-on-scroll">
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-200/60 overflow-hidden">
      <div class="border-b border-amber-200/60 bg-gradient-to-r from-amber-50 to-orange-50 px-6 py-4 sm:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-700">Real Scenario</p>
        <h2 class="mt-1 text-xl font-bold text-gray-900">How a 12-property team got control of 87 contract deadlines</h2>
      </div>
      <div class="p-6 sm:p-8">
        <p class="text-base leading-7 text-gray-600">
          A property management team overseeing 12 commercial properties was tracking leases in a shared spreadsheet
          and vendor contracts through calendar reminders. They uploaded 87 contracts to PactBadger and within the
          first week surfaced three upcoming vendor auto-renewals they hadn't been tracking.
        </p>

        <div class="mt-8 grid grid-cols-3 gap-4">
          <% [
            { label: "Day 1", value: "87", desc: "Contracts uploaded" },
            { label: "Day 3", value: "3", desc: "Missed renewals found" },
            { label: "Day 7", value: "1", desc: "Spreadsheet retired" }
          ].each do |stat| %>
            <div class="rounded-xl bg-gray-50 p-4 text-center ring-1 ring-gray-200/50">
              <p class="text-xs font-semibold uppercase tracking-wide text-amber-600"><%= stat[:label] %></p>
              <p class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900"><%= stat[:value] %></p>
              <p class="mt-1 text-xs text-gray-500"><%= stat[:desc] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Bottom CTA ── %>
<section class="relative bg-gray-950 py-16 sm:py-20 overflow-hidden">
  <div class="absolute inset-0 bg-mesh-gradient opacity-30"></div>
  <div class="absolute inset-0 bg-grid opacity-10"></div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Start tracking contracts in minutes</h2>
    <p class="mt-4 text-lg text-gray-300">Upload your first lease and let PactBadger extract key dates and create alerts for your team.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <%= link_to "Create Your Free Account", "#signup",
          class: "rounded-full bg-white px-8 py-3.5 text-base font-semibold text-gray-900 shadow-lg hover:bg-gray-100 transition-all duration-200" %>
    </div>
    <p class="mt-4 text-sm text-gray-400">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
  </div>
</section>
