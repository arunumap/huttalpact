<% content_for :title, "PactBadger for Property Managers — Never Miss Lease or Contract Deadlines" %>
<% content_for :meta_description, "Property managers use PactBadger to track leases and service contracts, extract key dates with AI, and stay ahead of renewals and notice windows." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :canonical_url, ads_contracts_landing_url %>

<% signup_params = @ads_signup_params || {} %>

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-600">For Property Managers</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          Never miss a lease or vendor contract deadline again
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600">
          PactBadger gives property management teams one place to track leases, service contracts, renewals, and notice windows—without spreadsheet chaos.
        </p>

        <dl class="mt-8 space-y-4">
          <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
            <dt class="text-sm font-semibold text-gray-900">Surface critical dates automatically</dt>
            <dd class="mt-1 text-sm text-gray-600">AI extraction captures renewal terms, notice periods, rent changes, and key obligations from your documents.</dd>
          </div>
          <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
            <dt class="text-sm font-semibold text-gray-900">Prevent expensive auto-renewals</dt>
            <dd class="mt-1 text-sm text-gray-600">Get in-app and email alerts before deadlines so your team has time to evaluate, negotiate, or exit.</dd>
          </div>
          <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
            <dt class="text-sm font-semibold text-gray-900">Align your whole team</dt>
            <dd class="mt-1 text-sm text-gray-600">Centralize contract data so asset managers, operations, and leadership see the same source of truth.</dd>
          </div>
        </dl>

        <p class="mt-6 text-sm text-gray-500">
          Free plan includes 10 contracts and 5 AI extractions per billing period. No credit card required.
        </p>
      </div>

      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900">Create your free account</h2>
        <p class="mt-2 text-sm text-gray-600">Start managing leases and contract deadlines in minutes.</p>

        <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
          <% signup_params.each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>

          <% if @user.errors.any? %>
            <div class="rounded-lg bg-red-50 p-3 ring-1 ring-red-200">
              <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :first_name, autocomplete: "given-name",
                  class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
            <div>
              <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :last_name, autocomplete: "family-name",
                  class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= label_tag "user_organization_name", "Company / Organization name", class: "block text-sm font-medium text-gray-700" %>
            <%= text_field_tag "user[organization_name]", @organization_name,
                autocomplete: "organization",
                class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Your property management company" %>
          </div>

          <div>
            <%= form.label :email_address, "Work email", class: "block text-sm font-medium text-gray-700" %>
            <%= form.email_field :email_address, required: true, autocomplete: "email",
                class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "you@company.com" %>
          </div>

          <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "At least 8 characters" %>
          </div>

          <div>
            <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                class: "mt-1 block w-full rounded-lg border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm",
                placeholder: "Confirm your password" %>
          </div>

          <div class="flex items-start gap-3">
            <%= form.check_box :terms_accepted, class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-600 cursor-pointer" %>
            <%= form.label :terms_accepted, class: "text-sm text-gray-600 cursor-pointer" do %>
              I agree to the <%= link_to "Terms of Use", terms_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %> and <%= link_to "Privacy Policy", privacy_path, class: "font-medium text-amber-600 hover:text-amber-500", target: "_blank" %>
            <% end %>
          </div>

          <div class="space-y-3">
            <%= form.submit "Create Free Account",
                data: { turbo_submits_with: "Creating account..." },
                class: "flex w-full justify-center rounded-lg bg-amber-600 px-3 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer" %>
            <p class="text-center text-sm text-gray-600">
              Already have an account?
              <%= link_to "Sign in", new_session_path, class: "font-medium text-amber-600 hover:text-amber-500" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="bg-gray-50 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Built for day-to-day property operations</h2>
      <p class="mt-4 text-lg text-gray-600">From lease oversight to vendor contract coordination, keep deadlines visible and actionable.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Lease timeline visibility</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600">Track rent escalations, option windows, and expiration timelines across your portfolio.</p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Vendor contract control</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600">Keep service agreements organized so renewals, cancellation windows, and pricing terms are always accessible.</p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Team-ready alerts</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600">Route upcoming deadline visibility to the right people before notice periods close.</p>
      </div>
    </div>
  </div>
</section>
