<% content_for :title, "Contract Intelligence Solutions — Supported Workflows | PactBadger" %>
<% content_for :meta_description, "Explore PactBadger solutions for leases, service agreements, maintenance agreements, insurance contracts, and software agreements." %>
<% content_for :canonical_url, solutions_url %>

<%= structured_data(type: :organization) %>
<%= structured_data(type: :software_application) %>

<section class="relative overflow-hidden bg-white" data-controller="scroll-animate">
  <div class="absolute inset-0 bg-mesh-gradient opacity-50"></div>
  <div class="absolute inset-0 bg-grid opacity-40"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-24 sm:pt-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200/60 mb-6 animate-on-scroll">
        Contract Intelligence Solutions
      </div>
      <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl leading-[1.05] animate-on-scroll stagger-1">
        Contract intelligence for <span class="text-gradient">every agreement type</span>
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600 animate-on-scroll stagger-2">
        PactBadger supports multiple contract types out of the box. Start with the solution that matches your workflow,
        then explore the exact terms, obligations, and deadlines PactBadger can track.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @solutions.each_with_index do |solution, index| %>
        <article class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200/60 hover:shadow-md hover:ring-gray-300 transition-all duration-300 animate-on-scroll stagger-delay-<%= (index % 3) + 1 %>">
          <div class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">
            <%= solution.name %>
          </div>

          <p class="mt-5 text-base leading-7 text-gray-600"><%= solution.index_blurb %></p>

          <div class="mt-5 flex flex-wrap gap-2">
            <% solution.highlights.each do |highlight| %>
              <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
                <%= highlight %>
              </span>
            <% end %>
          </div>

          <div class="mt-8">
            <%= link_to solution_path(solution.slug), class: "group inline-flex items-center gap-2 text-sm font-semibold text-amber-700 hover:text-amber-600 transition-colors" do %>
              View <%= solution.name %> solution
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="border-y border-gray-200/60 bg-gray-50 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <%= render "shared/section_heading",
        eyebrow: "How to use Solutions",
        title: "Start broad, then go deep".html_safe,
        subtitle: "Use the Solutions hub to browse supported workflows. Each detail page goes deeper on the exact extractions, clauses, and deadlines PactBadger can help your team track." %>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <% [
        { title: "Browse supported solutions", description: "See which agreement workflows PactBadger currently supports in the product." },
        { title: "Read the dedicated landing page", description: "Understand the clauses, milestones, and workflows most relevant for that solution." },
        { title: "Start extracting contracts", description: "Create a free account and begin uploading your agreements into a guided review workflow." }
      ].each_with_index do |item, index| %>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200/60 animate-on-scroll stagger-delay-<%= index + 1 %>">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-sm font-bold text-white">
            <%= index + 1 %>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-6 text-gray-600"><%= item[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="relative overflow-hidden bg-gray-950 py-20 sm:py-24">
  <div class="absolute inset-0 bg-mesh-gradient-dark"></div>
  <div class="absolute inset-0 bg-grid-dark"></div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Need a better contract system?</h2>
    <p class="mt-4 text-lg text-gray-300">
      Start free and explore how PactBadger helps your team extract key terms, review contracts, and stay ahead of deadlines.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <%= link_to "Start Free", new_registration_path,
          class: "rounded-full bg-white px-8 py-3.5 text-base font-semibold text-gray-900 shadow-lg hover:bg-gray-100 transition-all duration-200" %>
      <%= link_to "See Pricing", pricing_path,
          class: "rounded-full border border-white/20 bg-white/10 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/20 transition-all duration-200" %>
    </div>
    <p class="mt-4 text-sm text-gray-400">Free plan includes 10 contracts and 5 AI extractions. No credit card required.</p>
  </div>
</section>
