<%# Glass-morphism feature card with icon, title, and description.
     Locals:
       icon:        (String, required) — SVG path(s) for the icon
       title:       (String, required) — card heading
       description: (String, required) — card body text
       delay_class: (String, optional) — stagger class e.g. "stagger-1"
%>
<% delay_class = local_assigns.fetch(:delay_class, "") %>

<div class="group relative rounded-2xl p-8 glass-card hover-lift animate-on-scroll <%= delay_class %>
            ring-1 ring-gray-200/60 hover:ring-amber-300/50 transition-all duration-300">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 shadow-lg shadow-amber-500/20">
    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <%= icon.html_safe %>
    </svg>
  </div>
  <h3 class="mt-5 text-lg font-semibold text-gray-900"><%= title %></h3>
  <p class="mt-2 text-sm leading-6 text-gray-600"><%= description %></p>
</div>
