<footer class="border-t border-gray-200/50 bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-5">
      <%# Brand column %>
      <div class="col-span-2">
        <div class="flex items-center">
          <%= image_tag "pact_badger_log_light.svg", alt: "PactBadger", class: "h-10 w-auto" %>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-6 text-gray-400">
          AI-powered contract tracking for property management teams. Never miss a renewal, expiration, or notice window again.
        </p>
      </div>

      <%# Product %>
      <div>
        <h3 class="text-sm font-semibold text-white">Product</h3>
        <ul class="mt-4 space-y-3">
          <li><%= link_to "Home", root_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Leases", leases_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Pricing", pricing_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Blog", blog_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <%# Resources %>
      <div>
        <h3 class="text-sm font-semibold text-white">Resources</h3>
        <ul class="mt-4 space-y-3">
          <li><%= link_to "Get Started", new_registration_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Sign In", new_session_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
        </ul>
      </div>

      <%# Company %>
      <div>
        <h3 class="text-sm font-semibold text-white">Company</h3>
        <ul class="mt-4 space-y-3">
          <li><%= link_to "Privacy", privacy_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
          <li><%= link_to "Terms", terms_path, class: "text-sm text-gray-400 hover:text-white transition-colors" %></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-gray-800 pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-xs text-gray-500">&copy; <%= Date.current.year %> SageFoundry LLC, d/b/a PactBadger. All rights reserved.</p>
      <p class="text-xs text-gray-600">Built for teams who can't afford to miss a deadline.</p>
    </div>
  </div>
</footer>
