<% feedback = local_assigns[:feedback] || contract.extraction_feedbacks.find_by(user: Current.user) %>

<div id="extraction_feedback" data-controller="extraction-feedback">
  <% if feedback&.persisted? %>
    <div class="mt-3 flex items-center gap-2 text-xs">
      <span class="text-slate-500">Your feedback:</span>
      <% if feedback.rating == "positive" %>
        <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-green-700">
          <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/></svg>
          Helpful
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2 py-0.5 text-red-700">
          <svg class="h-3 w-3 rotate-180" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/></svg>
          Not helpful
        </span>
      <% end %>
      <button type="button" data-action="extraction-feedback#toggleForm" class="text-indigo-600 hover:text-indigo-500 underline">Change</button>
    </div>
    <div data-extraction-feedback-target="form" class="hidden">
  <% else %>
    <div data-extraction-feedback-target="form">
  <% end %>
    <div class="mt-3 rounded-md bg-slate-50 p-3">
      <p class="text-xs font-medium text-slate-600 mb-2">Was this extraction helpful?</p>
      <%= form_with model: [contract, feedback || ExtractionFeedback.new], url: contract_extraction_feedbacks_path(contract), method: :post, class: "space-y-2" do |form| %>
        <div class="flex items-center gap-2">
          <label class="cursor-pointer">
            <%= form.radio_button :rating, "positive", data: { action: "extraction-feedback#selectRating" },
                class: "sr-only peer" %>
            <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700 hover:bg-slate-100 transition">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/></svg>
              Helpful
            </span>
          </label>
          <label class="cursor-pointer">
            <%= form.radio_button :rating, "negative", data: { action: "extraction-feedback#selectRating" },
                class: "sr-only peer" %>
            <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 hover:bg-slate-100 transition">
              <svg class="h-3.5 w-3.5 rotate-180" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/></svg>
              Not helpful
            </span>
          </label>
        </div>
        <div data-extraction-feedback-target="commentSection" class="hidden">
          <%= form.text_area :comment, rows: 2, placeholder: "Optional: what could be improved?",
              class: "block w-full rounded-md border-slate-300 text-xs shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
        </div>
        <div data-extraction-feedback-target="submitSection" class="hidden">
          <%= form.submit "Submit Feedback",
              class: "rounded-md bg-indigo-600 px-3 py-1 text-xs font-semibold text-white hover:bg-indigo-500",
              data: { turbo_submits_with: "Submitting..." } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
