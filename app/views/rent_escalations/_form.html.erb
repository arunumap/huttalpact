<%= form_with model: [contract, rent_escalation], class: "space-y-6" do |form| %>
  <% if rent_escalation.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="text-sm text-red-700">
        <ul class="list-disc space-y-1 pl-5">
          <% rent_escalation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
    <div class="border-b border-gray-200 px-6 py-4">
      <h3 class="text-base font-semibold text-gray-900">Escalation Details</h3>
    </div>
    <div class="px-6 py-5 space-y-5">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :effective_date, class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :effective_date, required: true, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
        <div>
          <%= form.label :escalation_type, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :escalation_type, options_for_select(RentEscalation::ESCALATION_TYPES.map { |t| [t.titleize.gsub("_", " "), t] }, rent_escalation.escalation_type), { include_blank: "Select..." }, required: true, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div>
          <%= form.label :base_rent_monthly, "Monthly Rent ($)", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :base_rent_monthly, step: "0.01", min: "0", class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
        <div>
          <%= form.label :base_rent_annual, "Annual Rent ($)", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :base_rent_annual, step: "0.01", min: "0", class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
        </div>
        <div>
          <%= form.label :escalation_value, "Escalation Value", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :escalation_value, step: "0.01", class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">For percentages, enter the % value (e.g., 3 for 3%)</p>
        </div>
      </div>
      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :description, rows: 2, class: "mt-1 block w-full rounded-lg border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", contract, class: "rounded-lg px-4 py-2 text-sm font-semibold text-gray-700 hover:text-gray-900" %>
    <%= form.submit rent_escalation.persisted? ? "Update Escalation" : "Add Escalation", data: { turbo_submits_with: "Saving..." },
        class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 cursor-pointer" %>
  </div>
<% end %>
