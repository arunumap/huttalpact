<div class="space-y-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <%= link_to contracts_path, class: "inline-flex items-center gap-1 text-sm font-medium text-amber-600 hover:text-amber-500" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to contracts
      <% end %>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h2 class="text-2xl font-bold text-gray-900">Preparing human review</h2>
        <%= contract_status_badge(contract.status) %>
      </div>
      <p class="mt-1 text-sm text-gray-500"><%= contract.title %> · <%= pluralize(contract.contract_documents.count, "uploaded document") %></p>
    </div>
  </div>

  <div class="rounded-xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-900/5">
    <div class="max-w-3xl space-y-4">
      <div>
        <p class="text-sm font-semibold text-gray-900">We’re getting the review workspace ready.</p>
        <p class="mt-1 text-sm text-gray-500">Stay on this page while we finish extraction. The review checklist will appear here automatically as soon as it is ready.</p>
      </div>

      <%= render "contracts/draft_extraction_status", contract: %>

      <% if contract.extraction_status == "failed" || contract.extraction_blocked_by_limit? %>
        <div class="flex flex-wrap gap-2">
          <% if contract.extraction_status == "failed" && contract.contract_documents.completed.any? && !contract.extraction_blocked_by_limit? %>
            <%= button_to contract_extraction_path(contract), method: :post,
                class: "inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182M2.985 19.644l3.181-3.182" />
              </svg>
              Retry extraction
            <% end %>
          <% end %>

          <%= link_to edit_contract_path(contract),
              class: "inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
            Open manual editor
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
