<% needs_review = review.fields.needs_review.pending.ordered %>
<% confident = review.fields.confident.pending.ordered %>
<% reviewed = review.fields.reviewed.ordered %>
<% milestone_fields = review.fields.where(field_name: "lease_milestones").ordered %>
<% key_clause_fields = review.fields.where(field_name: "key_clauses").ordered %>
<% open_milestone_drawer_id = local_assigns[:open_milestone_drawer_id] %>
<% open_key_clause_drawer_id = local_assigns[:open_key_clause_drawer_id] %>
<% open_drawer_id = open_milestone_drawer_id.presence || open_key_clause_drawer_id.presence %>

<div id="review_panel"
  class="w-full lg:w-1/2 flex flex-col min-h-0 bg-gray-50"
  data-controller="milestone-drawer"
  data-action="keydown@window->milestone-drawer#closeOnEscape"
  <% if open_drawer_id.present? %>data-milestone-drawer-open-id-value="<%= open_drawer_id %>"<% end %>>
  <%# Scrollable content area %>
  <div class="flex-1 overflow-y-auto p-6 space-y-8">
    <%# Needs Review section %>
    <% if needs_review.any? %>
      <section>
        <div class="flex items-center gap-2 mb-4 pb-3 border-b-2 border-amber-300">
          <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-amber-100">
            <svg class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <h2 class="text-sm font-bold text-amber-800 uppercase tracking-wide">Needs Your Review</h2>
          <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-amber-500 text-white text-xs font-bold"><%= needs_review.size %></span>
        </div>

        <%# Group by field_group within this section %>
        <% needs_review.group_by(&:field_group).each do |group_key, group_fields| %>
          <div class="mb-6">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3"><%= ReviewFieldCatalog::FIELD_GROUP_LABELS[group_key] || group_key.titleize %></h3>
            <div class="space-y-3">
              <% group_fields.each do |field| %>
                <%= render "contract_reviews/field", field: field, review: review, contract: contract %>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# Confident Extractions section %>
    <% if confident.any? %>
      <section>
        <div class="flex items-center justify-between mb-4 pb-3 border-b-2 border-green-300">
          <div class="flex items-center gap-2">
            <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-green-100">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="text-sm font-bold text-green-800 uppercase tracking-wide">Confident Extractions</h2>
            <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-green-500 text-white text-xs font-bold"><%= confident.size %></span>
          </div>
          <%= button_to "Accept All ✓",
            bulk_accept_contract_contract_review_path(contract),
            method: :post,
            class: "inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-white bg-green-600 rounded-lg hover:bg-green-700 shadow-sm transition-colors" %>
        </div>

        <%# Group by field_group within this section %>
        <% confident.group_by(&:field_group).each do |group_key, group_fields| %>
          <div class="mb-6">
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3"><%= ReviewFieldCatalog::FIELD_GROUP_LABELS[group_key] || group_key.titleize %></h3>
            <div class="space-y-3">
              <% group_fields.each do |field| %>
                <%= render "contract_reviews/field", field: field, review: review, contract: contract %>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# Already Reviewed section %>
    <% if reviewed.any? %>
      <section>
        <div class="flex items-center gap-2 mb-4 pb-3 border-b-2 border-blue-200">
          <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-blue-50">
            <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0118 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3l1.5 1.5 3-3.75" />
            </svg>
          </div>
          <h2 class="text-sm font-bold text-blue-700 uppercase tracking-wide">Reviewed</h2>
          <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-blue-100 text-blue-700 text-xs font-bold"><%= reviewed.size %></span>
        </div>
        <div class="space-y-2">
          <% reviewed.each do |field| %>
            <%= render "contract_reviews/field", field: field, review: review, contract: contract %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Empty state %>
    <% if needs_review.empty? && confident.empty? && reviewed.empty? %>
      <div class="text-center py-16">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <p class="mt-2 text-sm text-gray-500">No fields to review yet.</p>
      </div>
    <% end %>
  </div>

  <%# Sticky footer with action buttons %>
  <div class="shrink-0 bg-white border-t border-gray-200 px-6 py-4">
    <div class="flex items-center justify-between">
      <%= button_to "Save Draft",
        save_draft_contract_contract_review_path(contract),
        method: :post,
        class: "inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 shadow-sm transition-colors" %>
      <%= button_to complete_contract_contract_review_path(contract),
        method: :post,
        disabled: !review.all_required_fields_reviewed?,
        class: "inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white rounded-lg shadow-sm transition-all #{review.all_required_fields_reviewed? ? 'bg-amber-600 hover:bg-amber-700 focus:ring-2 focus:ring-offset-2 focus:ring-amber-500' : 'bg-gray-300 cursor-not-allowed'}" do %>
        Complete Review
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
    </div>
  </div>

  <% milestone_fields.each do |field| %>
    <%= render "contract_reviews/milestone_drawer", field: field, contract: contract %>
  <% end %>

  <% key_clause_fields.each do |field| %>
    <%= render "contract_reviews/key_clause_drawer", field: field, contract: contract %>
  <% end %>
</div>
