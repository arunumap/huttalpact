<%# Sticky header with tabs + search %>
<div class="sticky top-0 z-10 bg-white border-b border-gray-200 px-4 pt-3 pb-0">
  <%# Document tabs %>
  <% if documents.length > 1 %>
    <div class="flex gap-1 mb-3 -mx-1" role="tablist">
      <% documents.each_with_index do |doc, idx| %>
        <button
          role="tab"
          data-action="document-viewer#switchDocument"
          data-document-viewer-doc-index-param="<%= idx %>"
          data-document-viewer-target="tab"
          class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors
            <%= idx == 0 ? 'bg-amber-100 text-amber-700' : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100' %>">
          <span class="truncate max-w-[160px] inline-block align-bottom"><%= doc[:name] %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <%# Search bar %>
  <div class="relative pb-3">
    <div class="absolute inset-y-0 left-0 pl-3 pb-3 flex items-center pointer-events-none">
      <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
    </div>
    <input type="text"
      placeholder="Search in document..."
      data-action="input->document-viewer#search"
      data-document-viewer-target="searchInput"
      class="w-full pl-9 pr-8 py-2 rounded-lg border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500 placeholder-gray-400">
    <button type="button" data-action="document-viewer#clearSearch" data-document-viewer-target="clearButton"
      class="hidden absolute inset-y-0 right-0 pr-3 pb-3 flex items-center text-gray-400 hover:text-gray-600">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<%# Document text panels %>
<div class="px-4 py-4">
  <% if documents.empty? %>
    <div class="text-center py-16">
      <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
      </svg>
      <p class="mt-2 text-sm text-gray-500">No extracted text available.</p>
    </div>
  <% else %>
    <% documents.each_with_index do |doc, idx| %>
      <div class="<%= idx == 0 ? '' : 'hidden' %>"
        data-document-viewer-target="documentPanel"
        data-document-id="<%= doc[:id] %>">
        <div class="flex items-center gap-2 mb-3 text-xs text-gray-400">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <span><%= doc[:name] %></span>
        </div>
        <% doc_text = doc[:text] || "" ; doc_lines = doc_text.split("\n", -1) ; _line_offsets = [] ; _off = 0 ; doc_lines.each { |l| _line_offsets << _off; _off += l.length + 1 } %>
        <div class="prose prose-sm max-w-none"
          data-document-viewer-target="documentText"
          data-document-id="<%= doc[:id] %>"><% doc_lines.each_with_index do |line, line_idx| %><div class="flex hover:bg-amber-50/50 transition-colors -mx-2 px-2 rounded" data-line="<%= line_idx + 1 %>" data-doc-offset-start="<%= _line_offsets[line_idx] %>" data-doc-offset-end="<%= _line_offsets[line_idx] + line.length %>"><span class="select-none text-xs text-gray-300 w-8 shrink-0 text-right pr-3 pt-0.5 font-mono"><%= line_idx + 1 %></span><span class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap flex-1"><%= line %></span></div><% end %></div>
      </div>
    <% end %>
  <% end %>
</div>
