<% milestones = milestone_items(field) %>
<% drawer_id = milestone_drawer_id(field) %>

<div class="hidden fixed inset-0 z-50"
  data-milestone-drawer-target="drawer"
  data-drawer-id="<%= drawer_id %>"
  aria-hidden="true">
  <div class="absolute inset-0 bg-gray-900/40 opacity-0 transition-opacity duration-300 ease-out"
    data-drawer-backdrop
    data-action="click->milestone-drawer#close"></div>

  <aside class="absolute inset-y-0 right-0 w-full max-w-2xl bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out motion-reduce:transition-none"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="<%= "#{drawer_id}_title" %>">
    <div class="flex items-start justify-between gap-4 border-b border-gray-200 px-5 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= field.display_name %></p>
        <h2 id="<%= "#{drawer_id}_title" %>" class="text-lg font-semibold text-gray-900">
          <%= pluralize(milestones.size, "milestone") %>
        </h2>
        <p class="mt-1 text-sm text-gray-500">Review, edit, or remove extracted milestones without touching JSON.</p>
      </div>

      <button type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-400 hover:bg-gray-100 hover:text-gray-600"
        data-action="click->milestone-drawer#close"
        aria-label="Close milestones panel">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
      <% if milestones.any? %>
        <% milestones.each_with_index do |milestone, index| %>
          <% recurring = ActiveModel::Type::Boolean.new.cast(milestone["recurring"]) %>
          <% source_excerpt = milestone_source_excerpt(milestone) %>
          <% source_locator = milestone_source_locator(milestone) %>
          <% evidence_status = milestone_evidence_status(milestone) %>
          <article class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-gray-900"><%= milestone_summary(milestone) %></h3>
                <p class="mt-1 text-xs text-gray-600"><%= milestone_purpose_text(milestone) %></p>
              </div>
              <%= button_to remove_milestone_contract_contract_review_path(contract),
                method: :delete,
                params: { field_id: field.id, milestone_index: index, open_milestone_drawer_id: drawer_id },
                form: { data: { turbo_confirm: "Delete this milestone?" } },
                class: "inline-flex items-center rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100" do %>
                Delete
              <% end %>
            </div>

            <% if source_excerpt.present? %>
              <blockquote class="mt-3 cursor-pointer rounded-r border-l-2 border-amber-400 bg-amber-50/70 py-2 pl-3 pr-2 transition-colors hover:bg-amber-50"
                data-action="click->milestone-drawer#focusSource"
                data-source-document-id="<%= source_locator['document_id'] %>"
                data-source-excerpt="<%= source_excerpt %>"
                <% if source_locator.present? %>data-source-start="<%= source_locator['start_offset'] %>" data-source-end="<%= source_locator['end_offset'] %>"<% end %>>
                <p class="text-xs italic leading-relaxed text-gray-700"><%= truncate(source_excerpt, length: 220) %></p>
              </blockquote>
            <% end %>

            <p class="mt-2 text-xs <%= evidence_status == 'unresolved' ? 'text-red-700' : 'text-gray-600' %>">
              <%= milestone_evidence_message(milestone) %>
            </p>

            <% if milestone_reasoning(milestone).present? %>
              <p class="mt-1 text-xs text-gray-500"><span class="font-medium text-gray-600">Why AI extracted this:</span> <%= milestone_reasoning(milestone) %></p>
            <% end %>

            <dl class="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-600 sm:grid-cols-2">
              <div>
                <dt class="font-medium text-gray-500">Type</dt>
                <dd><%= milestone_type_label(milestone["milestone_type"]) %></dd>
              </div>
              <div>
                <dt class="font-medium text-gray-500">Due date</dt>
                <dd><%= milestone_due_date_label(milestone) %></dd>
              </div>
              <div>
                <dt class="font-medium text-gray-500">Recurrence</dt>
                <dd><%= milestone_recurrence_label(milestone) %></dd>
              </div>
              <div>
                <dt class="font-medium text-gray-500">Description</dt>
                <dd><%= milestone["description"].presence || "No additional notes" %></dd>
              </div>
            </dl>

            <details class="mt-3 rounded-md border border-blue-200 bg-white p-3">
              <summary class="cursor-pointer text-xs font-semibold text-blue-700">Edit milestone</summary>
              <% type_input_id = "#{drawer_id}_type_#{index}" %>
              <% due_date_input_id = "#{drawer_id}_due_date_#{index}" %>
              <% recurrence_input_id = "#{drawer_id}_recurrence_#{index}" %>
              <% description_input_id = "#{drawer_id}_description_#{index}" %>
              <%= form_with url: update_milestone_contract_contract_review_path(contract),
                method: :patch,
                class: "mt-3 space-y-3" do %>
                <%= hidden_field_tag :field_id, field.id %>
                <%= hidden_field_tag :milestone_index, index %>
                <%= hidden_field_tag :open_milestone_drawer_id, drawer_id %>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div>
                    <%= label_tag type_input_id, "Milestone type", class: "mb-1 block text-xs font-medium text-gray-700" %>
                    <%= select_tag "milestone[milestone_type]",
                      options_for_select(milestone_type_options, milestone["milestone_type"]),
                      id: type_input_id,
                      class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                  </div>
                  <div>
                    <%= label_tag due_date_input_id, "Due date", class: "mb-1 block text-xs font-medium text-gray-700" %>
                    <%= date_field_tag "milestone[due_date]", milestone["due_date"],
                      id: due_date_input_id,
                      class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                  </div>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div>
                    <%= label_tag recurrence_input_id, "Recurrence", class: "mb-1 block text-xs font-medium text-gray-700" %>
                    <%= select_tag "milestone[recurrence_interval]",
                      options_for_select(milestone_recurrence_options, milestone["recurrence_interval"]),
                      include_blank: "No recurrence",
                      id: recurrence_input_id,
                      class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                  </div>
                  <div class="flex items-end pb-1">
                    <%= hidden_field_tag "milestone[recurring]", "0" %>
                    <% recurring_checkbox_id = "#{drawer_id}_recurring_#{index}" %>
                    <%= check_box_tag "milestone[recurring]", "1", recurring,
                      id: recurring_checkbox_id,
                      class: "h-4 w-4 rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
                    <%= label_tag recurring_checkbox_id, "Recurring milestone",
                      class: "ml-2 text-xs font-medium text-gray-700" %>
                  </div>
                </div>

                <div>
                  <%= label_tag description_input_id, "Description", class: "mb-1 block text-xs font-medium text-gray-700" %>
                  <%= text_area_tag "milestone[description]", milestone["description"],
                    id: description_input_id,
                    rows: 3,
                    class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                </div>

                <%= submit_tag "Save changes",
                  class: "inline-flex items-center rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700" %>
              <% end %>
            </details>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-center">
          <p class="text-sm text-gray-500">No milestones available to review.</p>
        </div>
      <% end %>
    </div>
  </aside>
</div>
