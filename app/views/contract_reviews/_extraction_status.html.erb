<% extraction = contract.extraction_status %>
<% docs = contract.contract_documents %>
<% total_docs = docs.count %>
<% completed_docs = docs.completed.count %>

<div id="review_extraction_processing" class="flex-1 flex items-center justify-center bg-gray-50">
<% if extraction == "processing" || (extraction == "pending" && total_docs > 0) %>
  <div class="max-w-md w-full text-center px-6">
    <div class="mx-auto mb-6">
      <svg class="h-12 w-12 animate-spin text-amber-600 mx-auto" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-900">AI is analyzing your contract</h2>
    <p class="mt-2 text-sm text-gray-500">Extracting key details for review. This usually takes 15–45 seconds.</p>

    <% if total_docs > 0 %>
      <div class="mt-6 max-w-xs mx-auto">
        <div class="flex items-center gap-3">
          <div class="flex-1 bg-gray-200 rounded-full h-2">
            <div class="bg-amber-600 h-2 rounded-full transition-all duration-500" style="width: <%= total_docs > 0 ? (completed_docs * 100 / total_docs) : 0 %>%"></div>
          </div>
          <span class="text-xs text-gray-600 font-medium whitespace-nowrap"><%= completed_docs %>/<%= total_docs %> docs</span>
        </div>
      </div>
    <% end %>

    <p class="mt-6 text-xs text-gray-400">The review will appear automatically when ready.</p>
  </div>

<% elsif extraction == "awaiting_type_confirmation" %>
  <div class="max-w-md w-full px-6">
    <div class="rounded-xl bg-amber-50 ring-1 ring-amber-200 px-6 py-6">
      <div class="text-center mb-4">
        <svg class="h-10 w-10 text-amber-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008zm8.25-3.75a8.25 8.25 0 11-16.5 0 8.25 8.25 0 0116.5 0z" />
        </svg>
        <h2 class="mt-3 text-lg font-semibold text-amber-800">Confirm contract type to continue</h2>
        <p class="mt-1 text-sm text-amber-700">
          <%= contract.last_changes_summary.presence || "We couldn't confidently determine the type from the document. Please choose it before extraction continues." %>
        </p>
      </div>

      <% type_options = Contract::CONTRACT_TYPES.map do |type|
           label = type == "service_agreement" ? "MSA / Service Agreement" : type.titleize.gsub("_", " ")
           [ label, type ]
         end %>

      <%= form_with url: confirm_type_contract_extraction_path(contract), method: :post, class: "flex flex-col gap-3" do %>
        <%= select_tag :contract_type,
            options_for_select([ [ "Select contract type...", "" ] ] + type_options, contract.contract_type),
            required: true,
            class: "block w-full rounded-lg border-0 py-2.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-amber-300 focus:ring-2 focus:ring-inset focus:ring-amber-600 sm:text-sm" %>

        <%= submit_tag "Confirm type & continue extraction",
            class: "w-full inline-flex items-center justify-center rounded-lg bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 cursor-pointer" %>
      <% end %>
    </div>
  </div>

<% elsif extraction == "failed" %>
  <div class="max-w-md w-full text-center px-6">
    <div class="mx-auto mb-4">
      <svg class="h-12 w-12 text-red-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-900">AI extraction failed</h2>
    <p class="mt-2 text-sm text-gray-500">Something went wrong during extraction. You can retry or fill in the details manually.</p>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= link_to "Retry Extraction", contract_extraction_path(contract), method: :post,
          class: "inline-flex items-center px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-500 font-medium text-sm" %>
      <%= link_to "Edit Manually", edit_contract_path(contract),
          class: "inline-flex items-center px-4 py-2 text-gray-700 bg-white ring-1 ring-gray-300 rounded-lg hover:bg-gray-50 font-medium text-sm" %>
    </div>
  </div>

<% elsif extraction == "completed" %>
  <%# Extraction completed but review hasn't been created yet — auto-redirect %>
  <div class="max-w-md w-full text-center px-6" data-controller="redirect" data-redirect-url-value="<%= contract_contract_review_path(contract) %>" data-redirect-delay-value="500">
    <div class="mx-auto mb-4">
      <svg class="h-12 w-12 text-green-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-900">Extraction Complete</h2>
    <p class="mt-1 text-sm text-gray-500">Loading review...</p>
  </div>
<% end %>
</div>
