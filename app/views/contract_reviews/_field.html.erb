<% catalog_entry = ReviewFieldCatalog.find(field.field_name) %>
<% parsed_value = parse_review_value(field.final_value) %>
<% is_reviewed = field.reviewed? %>
<% is_array = catalog_entry&.value_type == "array" %>
<% is_milestone_array_field = field.field_name == "lease_milestones" %>
<% is_key_clause_array_field = field.field_name == "key_clauses" %>
<% uncertainty_guidance = uncertainty_guidance_message(field) %>

<%= tag.div id: dom_id(field),
  class: "rounded-lg border transition-all #{is_reviewed ? 'bg-gray-50 border-gray-200' : 'bg-white border-gray-200 shadow-sm hover:shadow-md'}",
  data: { controller: "review-card", review_card_field_id_value: field.id,
          review_field_status: is_reviewed ? "reviewed" : "pending",
          needs_review: field.needs_review? ? "true" : "false" } do %>

  <div class="<%= is_reviewed ? 'px-4 py-3' : 'p-4' %>">
    <%# Header row %>
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-start gap-2 min-w-0">
        <% if is_reviewed %>
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        <% end %>
        <div class="min-w-0">
          <h3 class="text-sm font-medium <%= is_reviewed ? 'text-gray-500' : 'text-gray-900' %>"><%= field.display_name %></h3>
          <% if is_reviewed %>
            <p class="text-xs text-gray-400 mt-0.5"><%= format_review_value(field) %></p>
            <% if (is_milestone_array_field || is_key_clause_array_field) && parsed_value.is_a?(Array) %>
              <button type="button"
                data-action="milestone-drawer#open"
                data-milestone-drawer-id-param="<%= is_milestone_array_field ? milestone_drawer_id(field) : key_clause_drawer_id(field) %>"
                class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-800">
                (<%= parsed_value.length %>) view all
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <% if field.confidence %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= confidence_color_class(field.confidence) %>">
            <%= field.confidence %>%
          </span>
        <% end %>
        <% if is_reviewed %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= status_badge_class(field.status) %>">
            <%= field.status.humanize %>
          </span>
        <% end %>
      </div>
    </div>

    <%# Full content for non-reviewed fields %>
    <% unless is_reviewed %>
      <%# Value display %>
      <div class="mt-3">
        <% if is_milestone_array_field && parsed_value.is_a?(Array) %>
          <div class="rounded-md border border-blue-100 bg-blue-50/60 px-3 py-2">
            <p class="text-xs text-blue-800">
              AI extracted milestone deadlines and obligations you can review as individual cards.
            </p>
            <button type="button"
              data-action="milestone-drawer#open"
              data-milestone-drawer-id-param="<%= milestone_drawer_id(field) %>"
              class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-blue-700 hover:text-blue-900">
              (<%= parsed_value.length %>) view all
            </button>
          </div>
        <% elsif is_key_clause_array_field && parsed_value.is_a?(Array) %>
          <div class="rounded-md border border-blue-100 bg-blue-50/60 px-3 py-2">
            <p class="text-xs text-blue-800">
              AI extracted key legal clauses you can review as individual cards.
            </p>
            <button type="button"
              data-action="milestone-drawer#open"
              data-milestone-drawer-id-param="<%= key_clause_drawer_id(field) %>"
              class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-blue-700 hover:text-blue-900">
              (<%= parsed_value.length %>) view all
            </button>
          </div>
        <% elsif is_array && parsed_value.is_a?(Array) %>
          <%# Array summary with expandable detail %>
          <div>
            <button type="button" data-action="review-card#toggleArray"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 hover:text-gray-900">
              <svg class="w-4 h-4 transition-transform" data-review-card-target="arrayChevron" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded-md text-xs font-semibold"><%= parsed_value.length %></span>
              <%= "item".pluralize(parsed_value.length) %> extracted
            </button>
            <div class="hidden mt-2" data-review-card-target="arrayDetail">
              <div class="bg-gray-50 rounded-md p-3 space-y-2 max-h-48 overflow-y-auto text-xs font-mono text-gray-600">
                <% parsed_value.each_with_index do |item, idx| %>
                  <div class="<%= idx > 0 ? 'pt-2 border-t border-gray-200' : '' %>">
                    <% if item.is_a?(Hash) %>
                      <% item.each do |k, v| %>
                        <div><span class="text-gray-400"><%= k %>:</span> <span class="text-gray-800"><%= v %></span></div>
                      <% end %>
                    <% else %>
                      <div class="text-gray-800"><%= item %></div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% elsif parsed_value.nil? %>
          <p class="text-sm text-gray-400 italic">No value extracted</p>
        <% else %>
          <p class="text-sm font-medium text-gray-900"><%= format_review_value(field) %></p>
        <% end %>
      </div>

      <%# Source excerpt %>
      <% if field.source_excerpt.present? %>
        <blockquote class="mt-3 pl-3 border-l-2 border-amber-400 bg-amber-50/50 py-2 pr-3 rounded-r cursor-pointer hover:bg-amber-50 transition-colors"
                    data-action="click->review-card#focusSource"
                    data-source-document-id="<%= field.source_locator&.dig('document_id') || field.source_document_id %>"
                    data-source-excerpt="<%= field.source_excerpt %>"
                    <% if field.source_locator.present? %>data-source-start="<%= field.source_locator['start_offset'] %>" data-source-end="<%= field.source_locator['end_offset'] %>"<% end %>>
          <p class="text-xs text-gray-600 italic leading-relaxed"><%= truncate(field.source_excerpt, length: 250) %></p>
        </blockquote>
      <% elsif uncertainty_guidance.present? %>
        <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2">
          <p class="text-xs text-amber-800"><%= uncertainty_guidance %></p>
        </div>
      <% end %>

      <%# AI reasoning (collapsible) %>
      <% if field.reasoning.present? %>
        <details class="mt-2 group">
          <summary class="text-xs text-gray-400 hover:text-gray-600 cursor-pointer flex items-center gap-1 select-none">
            <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
            AI reasoning
          </summary>
          <p class="mt-1 text-xs text-gray-500 pl-4 leading-relaxed"><%= field.reasoning %></p>
        </details>
      <% end %>

      <%# Action buttons %>
      <div class="mt-4 flex items-center gap-2 flex-wrap">
        <%= button_to update_field_contract_contract_review_path(contract),
          method: :patch,
          params: { field_id: field.id, decision: "confirm" },
          class: "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-md hover:bg-green-100 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Confirm
        <% end %>

        <% if is_milestone_array_field && parsed_value.is_a?(Array) %>
          <button type="button"
            data-action="milestone-drawer#open"
            data-milestone-drawer-id-param="<%= milestone_drawer_id(field) %>"
            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors">
            Edit milestones
          </button>
        <% elsif is_key_clause_array_field && parsed_value.is_a?(Array) %>
          <button type="button"
            data-action="milestone-drawer#open"
            data-milestone-drawer-id-param="<%= key_clause_drawer_id(field) %>"
            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors">
            Edit clauses
          </button>
        <% else %>
          <button type="button"
            data-action="review-card#toggleEdit"
            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487z" />
            </svg>
            Edit
          </button>
        <% end %>

        <%= button_to update_field_contract_contract_review_path(contract),
          method: :patch,
          params: { field_id: field.id, decision: "not_found" },
          class: "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-500 bg-gray-50 border border-gray-200 rounded-md hover:bg-gray-100 transition-colors" do %>
          Not Found
        <% end %>

        <%= button_to update_field_contract_contract_review_path(contract),
          method: :patch,
          params: { field_id: field.id, decision: "not_applicable" },
          class: "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-500 bg-gray-50 border border-gray-200 rounded-md hover:bg-gray-100 transition-colors" do %>
          N/A
        <% end %>
      </div>

      <% unless is_milestone_array_field || is_key_clause_array_field %>
        <%# Edit form (hidden by default) — typed inputs based on catalog %>
        <div class="mt-3 hidden" data-review-card-target="editForm">
          <%= form_with url: update_field_contract_contract_review_path(contract), method: :patch,
            class: "rounded-lg border border-blue-200 bg-blue-50/50 p-3" do |f| %>
            <%= f.hidden_field :field_id, value: field.id %>
            <%= f.hidden_field :decision, value: "edit" %>
            <div class="mb-3">
              <label class="block text-xs font-medium text-gray-700 mb-1"><%= field.display_name %></label>
              <%= review_field_input(f, field) %>
            </div>
            <div class="flex items-center gap-2">
              <%= f.submit "Save",
                class: "inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-amber-600 rounded-md hover:bg-amber-700 shadow-sm transition-colors cursor-pointer" %>
              <button type="button" data-action="review-card#toggleEdit"
                class="text-xs text-gray-500 hover:text-gray-700">Cancel</button>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
