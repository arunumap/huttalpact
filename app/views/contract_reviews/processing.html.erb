<% content_for :page_title, "Processing: #{@contract.title}" %>

<%= turbo_stream_from "contract_#{@contract.id}" %>

<div class="-m-4 sm:-m-6 flex flex-col h-[calc(100vh-4rem)]">
  <%# Compact header bar %>
  <div class="bg-white border-b border-gray-200 px-4 py-3 sm:px-6 shrink-0">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <%= link_to contracts_path, class: "shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
        <% end %>
        <div class="min-w-0">
          <h1 class="text-base font-semibold text-gray-900 truncate"><%= @contract.title %></h1>
          <p class="text-xs text-gray-500">Preparing contract for review</p>
        </div>
      </div>
    </div>
  </div>

  <%# Processing content — centered in remaining space %>
  <div class="flex-1 flex flex-col min-h-0">
    <%= render "contract_reviews/extraction_status", contract: @contract %>
  </div>
</div>
