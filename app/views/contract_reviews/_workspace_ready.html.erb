<div class="space-y-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <%= link_to contract_path(contract), class: "inline-flex items-center gap-1 text-sm font-medium text-amber-600 hover:text-amber-500" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to contract
      <% end %>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h2 class="text-2xl font-bold text-gray-900">Human review</h2>
        <%= contract_status_badge(contract.status) %>
        <%= tag.span(review.review_trigger.humanize, class: "inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600") %>
      </div>
      <p class="mt-1 text-sm text-gray-500"><%= contract.title %> · <%= contract.vendor_name.presence || "No vendor captured" %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if review.open? %>
        <%= button_to save_progress_contract_review_path(contract), method: :patch,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
          <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2.25" />
          </svg>
          Save progress
        <% end %>

        <%= button_to bulk_confirm_safe_items_contract_review_path(contract), method: :patch,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-green-700 shadow-sm ring-1 ring-inset ring-green-300 hover:bg-green-50" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m6 2.25a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Confirm <%= pluralize(looks_good_fields.count, "safe field") %>
        <% end %>

        <%= button_to complete_contract_review_path(contract), method: :patch,
            data: { turbo_confirm: "Complete review and activate approved alert changes?" },
            class: "inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Complete review
        <% end %>
      <% else %>
        <div class="rounded-lg bg-emerald-50 px-4 py-2 text-sm text-emerald-800 ring-1 ring-emerald-200">
          Review completed <%= time_ago_in_words(review.completed_at) %> ago.
        </div>
      <% end %>
    </div>
  </div>

  <% if contract.in_review? %>
    <div class="rounded-xl bg-orange-50 px-5 py-4 ring-1 ring-orange-200">
      <p class="text-sm font-semibold text-orange-800">Live alerts stay in place until you complete review.</p>
      <p class="mt-1 text-sm text-orange-700">Use this screen to confirm safe fields, resolve exceptions, and explicitly complete review when activation-driving items are ready.</p>
    </div>
  <% elsif follow_through_summary[:pending_count].positive? %>
    <div class="rounded-xl bg-blue-50 px-5 py-4 ring-1 ring-blue-200">
      <p class="text-sm font-semibold text-blue-800">Follow-through remains open after activation.</p>
      <p class="mt-1 text-sm text-blue-700"><%= pluralize(follow_through_summary[:pending_count], "standard-priority item") %> still need review, but current alerts are already running from approved data.</p>
      <% if follow_through_summary[:average_resolution_hours].present? %>
        <p class="mt-2 text-xs text-blue-600">Average follow-through resolution time: <%= follow_through_summary[:average_resolution_hours] %> hours.</p>
      <% end %>
    </div>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-4">
    <div class="rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Looks good</p>
      <p class="mt-2 text-2xl font-bold text-gray-900"><%= review.looks_good_fields_count %></p>
      <p class="mt-1 text-xs text-gray-500"><%= pluralize(looks_good_fields.count, "pending safe field") %> can be mass-confirmed.</p>
    </div>
    <div class="rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Needs review</p>
      <p class="mt-2 text-2xl font-bold text-amber-700"><%= review.needs_review_fields_count %></p>
      <p class="mt-1 text-xs text-gray-500">Standard-priority follow-up items stay available after completion.</p>
    </div>
    <div class="rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Blocked</p>
      <p class="mt-2 text-2xl font-bold text-red-700"><%= review.blocked_fields_count %></p>
      <p class="mt-1 text-xs text-gray-500">Blocking items must be resolved or invalidated before completion.</p>
    </div>
    <div class="rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Open conflicts</p>
      <p class="mt-2 text-2xl font-bold text-gray-900"><%= review.open_conflicts_count %></p>
      <p class="mt-1 text-xs text-gray-500">Evidence mismatches and derived dependency gaps are tracked here.</p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)]">
    <div class="space-y-6">
      <% if blocked_fields.any? %>
        <section class="rounded-xl bg-white shadow-sm ring-1 ring-red-200">
          <div class="border-b border-red-200 bg-red-50 px-6 py-4 rounded-t-xl">
            <h3 class="text-base font-semibold text-red-900">Blocking · <%= blocked_fields.count %></h3>
            <p class="mt-1 text-sm text-red-700">These items must be resolved before you can complete review and activate alerts.</p>
          </div>
          <div class="divide-y divide-gray-200">
            <%= render partial: "contract_reviews/field", collection: blocked_fields, as: :field, locals: { contract:, review: } %>
          </div>
        </section>
      <% end %>

      <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-base font-semibold text-gray-900">Needs review · <%= needs_review_fields.count %></h3>
          <p class="mt-1 text-sm text-gray-500">Non-blocking items that should be inspected. These won't prevent completion.</p>
        </div>
        <div class="divide-y divide-gray-200">
          <% if needs_review_fields.any? %>
            <%= render partial: "contract_reviews/field", collection: needs_review_fields, as: :field, locals: { contract:, review: } %>
          <% else %>
            <p class="px-6 py-8 text-sm text-gray-500">No exceptions remain in this review.</p>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5" data-controller="disclosure" data-disclosure-open-value="false">
        <button type="button" data-action="disclosure#toggle" class="flex w-full items-center justify-between border-b border-gray-200 px-6 py-4 text-left">
          <div>
            <h3 class="text-base font-semibold text-gray-900">Looks good · <%= looks_good_fields.count %></h3>
            <p class="mt-1 text-sm text-gray-500">High-confidence fields ready for bulk confirmation.</p>
          </div>
          <svg class="h-5 w-5 text-gray-400 transition-transform" data-disclosure-target="icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="divide-y divide-gray-200" data-disclosure-target="body" style="display: none;">
          <% if looks_good_fields.any? %>
            <%= render partial: "contract_reviews/field", collection: looks_good_fields, as: :field, locals: { contract:, review: } %>
          <% else %>
            <p class="px-6 py-8 text-sm text-gray-500">There are no remaining safe fields waiting on confirmation.</p>
          <% end %>
        </div>
      </section>
    </div>

    <aside class="space-y-6">
      <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-base font-semibold text-gray-900">Completion rules</h3>
        </div>
        <div class="space-y-3 px-6 py-5 text-sm text-gray-600">
          <p>• Save progress keeps the contract <strong>in review</strong>.</p>
          <p>• Only <strong>Complete review</strong> moves the contract back to its active lifecycle state.</p>
          <p>• Explicitly marking a field <strong>Not found</strong> or <strong>Not applicable</strong> clears that blocker and records the decision.</p>
          <p>• Standard-priority items can remain open for follow-through after activation.</p>
        </div>
      </div>

      <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-base font-semibold text-gray-900">Follow-through</h3>
        </div>
        <div class="space-y-3 px-6 py-5 text-sm text-gray-600">
          <div class="flex items-center justify-between">
            <span>Pending items</span>
            <span class="font-semibold text-gray-900"><%= follow_through_summary[:pending_count] %></span>
          </div>
          <div class="flex items-center justify-between">
            <span>Resolved after completion</span>
            <span class="font-semibold text-gray-900"><%= follow_through_summary[:resolved_count] %></span>
          </div>
          <div class="flex items-center justify-between">
            <span>Average resolution</span>
            <span class="font-semibold text-gray-900"><%= follow_through_summary[:average_resolution_hours].present? ? "#{follow_through_summary[:average_resolution_hours]}h" : "—" %></span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
