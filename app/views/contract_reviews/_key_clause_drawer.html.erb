<% clauses = key_clause_items(field) %>
<% drawer_id = key_clause_drawer_id(field) %>

<div class="hidden fixed inset-0 z-50"
  data-milestone-drawer-target="drawer"
  data-drawer-id="<%= drawer_id %>"
  aria-hidden="true">
  <div class="absolute inset-0 bg-gray-900/40 opacity-0 transition-opacity duration-300 ease-out"
    data-drawer-backdrop
    data-action="click->milestone-drawer#close"></div>

  <aside class="absolute inset-y-0 right-0 w-full max-w-2xl bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out motion-reduce:transition-none"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="<%= "#{drawer_id}_title" %>">
    <div class="flex items-start justify-between gap-4 border-b border-gray-200 px-5 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500"><%= field.display_name %></p>
        <h2 id="<%= "#{drawer_id}_title" %>" class="text-lg font-semibold text-gray-900">
          <%= pluralize(clauses.size, "key clause") %>
        </h2>
        <p class="mt-1 text-sm text-gray-500">Review, edit, or remove extracted clauses without touching JSON.</p>
      </div>

      <button type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-400 hover:bg-gray-100 hover:text-gray-600"
        data-action="click->milestone-drawer#close"
        aria-label="Close key clauses panel">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
      <% if clauses.any? %>
        <% clauses.each_with_index do |key_clause, index| %>
          <% source_excerpt = key_clause_source_excerpt(key_clause) %>
          <% source_locator = key_clause_source_locator(key_clause) %>
          <% evidence_status = key_clause_evidence_status(key_clause) %>
          <article class="rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-gray-900"><%= key_clause_summary(key_clause) %></h3>
                <p class="mt-1 text-xs text-gray-600"><%= key_clause_purpose_text(key_clause) %></p>
              </div>
              <%= button_to remove_key_clause_contract_contract_review_path(contract),
                method: :delete,
                params: { field_id: field.id, key_clause_index: index, open_key_clause_drawer_id: drawer_id },
                form: { data: { turbo_confirm: "Delete this key clause?" } },
                class: "inline-flex items-center rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100" do %>
                Delete
              <% end %>
            </div>

            <% if source_excerpt.present? %>
              <blockquote class="mt-3 cursor-pointer rounded-r border-l-2 border-amber-400 bg-amber-50/70 py-2 pl-3 pr-2 transition-colors hover:bg-amber-50"
                data-action="click->milestone-drawer#focusSource"
                data-source-document-id="<%= source_locator['document_id'] %>"
                data-source-excerpt="<%= source_excerpt %>"
                <% if source_locator.present? %>data-source-start="<%= source_locator['start_offset'] %>" data-source-end="<%= source_locator['end_offset'] %>"<% end %>>
                <p class="text-xs italic leading-relaxed text-gray-700"><%= truncate(source_excerpt, length: 220) %></p>
              </blockquote>
            <% end %>

            <p class="mt-2 text-xs <%= evidence_status == 'unresolved' ? 'text-red-700' : 'text-gray-600' %>">
              <%= key_clause_evidence_message(key_clause) %>
            </p>

            <% if key_clause_reasoning(key_clause).present? %>
              <p class="mt-1 text-xs text-gray-500"><span class="font-medium text-gray-600">Why AI extracted this:</span> <%= key_clause_reasoning(key_clause) %></p>
            <% end %>

            <dl class="mt-3 grid grid-cols-1 gap-2 text-xs text-gray-600 sm:grid-cols-2">
              <div>
                <dt class="font-medium text-gray-500">Type</dt>
                <dd><%= key_clause_type_label(key_clause["clause_type"]) %></dd>
              </div>
              <div>
                <dt class="font-medium text-gray-500">Confidence</dt>
                <dd><%= key_clause_confidence_label(key_clause) %></dd>
              </div>
              <div>
                <dt class="font-medium text-gray-500">Page / section</dt>
                <dd><%= key_clause["page_reference"].presence || "Not provided" %></dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="font-medium text-gray-500">Clause text</dt>
                <dd><%= key_clause["content"].presence || "No clause text available" %></dd>
              </div>
            </dl>

            <details class="mt-3 rounded-md border border-blue-200 bg-white p-3">
              <summary class="cursor-pointer text-xs font-semibold text-blue-700">Edit clause</summary>
              <% type_input_id = "#{drawer_id}_type_#{index}" %>
              <% content_input_id = "#{drawer_id}_content_#{index}" %>
              <% reference_input_id = "#{drawer_id}_reference_#{index}" %>
              <% confidence_input_id = "#{drawer_id}_confidence_#{index}" %>
              <%= form_with url: update_key_clause_contract_contract_review_path(contract),
                method: :patch,
                class: "mt-3 space-y-3" do %>
                <%= hidden_field_tag :field_id, field.id %>
                <%= hidden_field_tag :key_clause_index, index %>
                <%= hidden_field_tag :open_key_clause_drawer_id, drawer_id %>

                <div>
                  <%= label_tag type_input_id, "Clause type", class: "mb-1 block text-xs font-medium text-gray-700" %>
                  <%= select_tag "key_clause[clause_type]",
                    options_for_select(key_clause_type_options, key_clause["clause_type"]),
                    id: type_input_id,
                    class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                </div>

                <div>
                  <%= label_tag content_input_id, "Clause text", class: "mb-1 block text-xs font-medium text-gray-700" %>
                  <%= text_area_tag "key_clause[content]", key_clause["content"],
                    id: content_input_id,
                    rows: 4,
                    class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                </div>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div>
                    <%= label_tag reference_input_id, "Page / section", class: "mb-1 block text-xs font-medium text-gray-700" %>
                    <%= text_field_tag "key_clause[page_reference]", key_clause["page_reference"],
                      id: reference_input_id,
                      class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                  </div>
                  <div>
                    <%= label_tag confidence_input_id, "Confidence (0-100)", class: "mb-1 block text-xs font-medium text-gray-700" %>
                    <%= number_field_tag "key_clause[confidence_score]", key_clause["confidence_score"],
                      id: confidence_input_id,
                      min: 0,
                      max: 100,
                      step: 1,
                      class: "w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
                  </div>
                </div>

                <%= submit_tag "Save changes",
                  class: "inline-flex items-center rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700" %>
              <% end %>
            </details>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-center">
          <p class="text-sm text-gray-500">No key clauses available to review.</p>
        </div>
      <% end %>
    </div>
  </aside>
</div>
