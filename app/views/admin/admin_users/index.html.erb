<% content_for :title, "Admin Users" %>
<% content_for :page_title, "Admin Users" %>

<div class="space-y-4">
  <div class="flex items-center justify-end">
    <%= link_to "New Admin User", new_admin_admin_user_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <%= form_with url: admin_admin_users_path, method: :get, class: "mb-4" do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Search by name or email", class: "w-full rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <% end %>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Name</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Email</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Sessions</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Created</th>
            <th class="px-3 py-2 text-right font-medium text-slate-600">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @admin_users.each do |admin_user| %>
            <tr>
              <td class="px-3 py-2"><%= link_to admin_user.full_name, admin_admin_user_path(admin_user), class: "font-medium text-indigo-700 hover:text-indigo-600" %></td>
              <td class="px-3 py-2"><%= admin_user.email_address %></td>
              <td class="px-3 py-2"><%= admin_user.admin_sessions.count %></td>
              <td class="px-3 py-2"><%= admin_user.created_at.to_date %></td>
              <td class="px-3 py-2 text-right">
                <%= link_to "Edit", edit_admin_admin_user_path(admin_user), class: "text-indigo-700 hover:text-indigo-600" %>
                <% unless admin_user == Current.admin_user %>
                  <span class="mx-1 text-slate-300">|</span>
                  <%= button_to "Delete", admin_admin_user_path(admin_user), method: :delete, form: { class: "inline", data: { turbo_confirm: "Delete this admin user?" } }, class: "text-red-700 hover:text-red-600" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @admin_users.empty? %>
            <tr>
              <td colspan="5" class="px-3 py-8 text-center text-slate-500">No admin users found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
