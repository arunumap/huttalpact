<% content_for :title, "Admin Dashboard" %>
<% content_for :page_title, "Dashboard" %>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Total Users</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @total_users %></p>
  </div>
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Total Organizations</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @total_organizations %></p>
  </div>
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Total Contracts</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @total_contracts %></p>
  </div>
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Documents</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @total_documents %></p>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Session Health</h3>
    <dl class="mt-3 space-y-2 text-sm text-slate-700">
      <div class="flex justify-between"><dt>Active user sessions</dt><dd><%= @active_user_sessions %></dd></div>
      <div class="flex justify-between"><dt>Active admin sessions</dt><dd><%= @active_admin_sessions %></dd></div>
    </dl>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">AI Usage (30 days)</h3>
    <dl class="mt-3 space-y-2 text-sm text-slate-700">
      <div class="flex justify-between"><dt>Total logs</dt><dd><%= @ai_log_count_30d %></dd></div>
      <div class="flex justify-between"><dt>Failed logs</dt><dd><%= @failed_ai_logs_30d %></dd></div>
      <div class="flex justify-between"><dt>Input tokens</dt><dd><%= number_with_delimiter(@ai_input_tokens_30d) %></dd></div>
      <div class="flex justify-between"><dt>Output tokens</dt><dd><%= number_with_delimiter(@ai_output_tokens_30d) %></dd></div>
      <div class="flex justify-between"><dt>Estimated cost</dt><dd><%= number_to_currency(@ai_estimated_cost_30d) %></dd></div>
    </dl>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Queue Health</h3>
    <dl class="mt-3 space-y-2 text-sm text-slate-700">
      <div class="flex justify-between"><dt>Healthy workers</dt><dd><%= @healthy_workers %></dd></div>
      <div class="flex justify-between"><dt>Pending jobs</dt><dd><%= @pending_jobs %></dd></div>
      <div class="flex justify-between"><dt>Running jobs</dt><dd><%= @running_jobs %></dd></div>
      <div class="flex justify-between"><dt>Failed jobs</dt><dd><%= @failed_jobs %></dd></div>
    </dl>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Storage</h3>
    <dl class="mt-3 space-y-2 text-sm text-slate-700">
      <div class="flex justify-between"><dt>Total blob storage</dt><dd><%= number_to_human_size(@total_storage_bytes) %></dd></div>
      <div class="flex justify-between"><dt>Total documents</dt><dd><%= @total_documents %></dd></div>
      <div class="flex justify-between"><dt>Total contracts</dt><dd><%= @total_contracts %></dd></div>
    </dl>
  </div>
</div>

<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h3 class="text-sm font-semibold text-slate-900">Organizations by Plan</h3>
  <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
    <% PlanCatalogService.available_plan_slugs.each do |plan| %>
      <div class="rounded-md bg-slate-50 p-3 text-sm text-slate-700">
        <p class="font-medium text-slate-900"><%= plan.titleize %></p>
        <p class="mt-1"><%= @plan_distribution[plan] || 0 %></p>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="text-sm font-semibold text-slate-900">Recent Activity</h3>
  <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Organization</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">User</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @recent_audit_logs.each do |log| %>
        <tr>
          <td class="px-3 py-2"><%= log.created_at.to_fs(:db) %></td>
          <td class="px-3 py-2"><%= log.organization&.name || "n/a" %></td>
          <td class="px-3 py-2"><%= log.user&.email_address || "System" %></td>
          <td class="px-3 py-2"><%= log.action.to_s.humanize %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
