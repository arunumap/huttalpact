<% content_for :title, "Admin AI Usage" %>
<% content_for :page_title, "AI Usage" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <%= form_with url: admin_ai_usage_index_path, method: :get, class: "grid grid-cols-1 gap-2 sm:grid-cols-4" do |form| %>
    <%= form.date_field :start_date, value: @start_date, class: "rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <%= form.date_field :end_date, value: @end_date, class: "rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <%= form.collection_select :organization_id, @organizations, :id, :name, { include_blank: "All organizations", selected: params[:organization_id] }, class: "rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <%= form.submit "Apply", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-4 text-sm">
    <div class="rounded-md bg-slate-50 p-3"><p class="text-slate-500">Input Tokens</p><p class="mt-1 font-semibold text-slate-900"><%= number_with_delimiter(@total_input_tokens) %></p></div>
    <div class="rounded-md bg-slate-50 p-3"><p class="text-slate-500">Output Tokens</p><p class="mt-1 font-semibold text-slate-900"><%= number_with_delimiter(@total_output_tokens) %></p></div>
    <div class="rounded-md bg-slate-50 p-3"><p class="text-slate-500">Total Tokens</p><p class="mt-1 font-semibold text-slate-900"><%= number_with_delimiter(@total_tokens) %></p></div>
    <div class="rounded-md bg-slate-50 p-3"><p class="text-slate-500">Estimated Cost</p><p class="mt-1 font-semibold text-slate-900"><%= number_to_currency(@estimated_cost) %></p></div>
  </div>
</div>

<div class="mt-4 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="mb-3 text-sm font-semibold text-slate-900">Usage Logs</h3>
  <% if @usage_logs.any? %>
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Organization</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Model</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Tokens</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @usage_logs.each do |log| %>
        <tr>
          <td class="px-3 py-2"><%= log.created_at.to_fs(:db) %></td>
          <td class="px-3 py-2"><%= log.organization.name %></td>
          <td class="px-3 py-2"><%= log.ai_model %></td>
          <td class="px-3 py-2"><%= number_with_delimiter(log.total_tokens) %></td>
          <td class="px-3 py-2"><%= log.success? ? "Success" : "Failed" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% else %>
    <p class="text-sm text-slate-500">No usage logs found for the selected filters.</p>
  <% end %>
</div>

<div class="mt-4 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="mb-3 text-sm font-semibold text-slate-900">Daily Token Totals</h3>
  <% if @daily_usage.any? %>
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Date</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Tokens</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @daily_usage.each do |date, token_total| %>
          <tr>
            <td class="px-3 py-2"><%= date %></td>
            <td class="px-3 py-2"><%= number_with_delimiter(token_total) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-slate-500">No daily usage data available.</p>
  <% end %>
</div>
