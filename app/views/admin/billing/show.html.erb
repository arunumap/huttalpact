<% content_for :title, "Admin Billing" %>
<% content_for :page_title, "Billing" %>

<%# ── Stripe Products & Prices Status ── %>
<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center justify-between">
    <h3 class="text-sm font-semibold text-slate-900">Stripe Products &amp; Prices</h3>
    <% if @stripe_status[:error] %>
      <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700">Error</span>
    <% elsif @stripe_status[:complete] %>
      <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700">Complete</span>
    <% else %>
      <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700">Incomplete</span>
    <% end %>
  </div>

  <% if @stripe_status[:error] %>
    <p class="mt-3 text-sm text-red-600">Could not connect to Stripe: <%= @stripe_status[:message] %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Lookup Key</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Price ID</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Amount</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Interval</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% PlanLimits::LOOKUP_KEYS.keys.each do |key| %>
            <% price = @stripe_status[:prices]&.find { |p| p[:lookup_key] == key } %>
            <tr>
              <td class="px-3 py-2 font-mono text-xs"><%= key %></td>
              <% if price %>
                <td class="px-3 py-2"><span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">✅ Configured</span></td>
                <td class="px-3 py-2 font-mono text-xs"><%= price[:price_id] %></td>
                <td class="px-3 py-2">$<%= price[:amount].to_i / 100 %></td>
                <td class="px-3 py-2"><%= price[:interval] %></td>
              <% else %>
                <td class="px-3 py-2"><span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">❌ Missing</span></td>
                <td class="px-3 py-2 text-slate-400">—</td>
                <td class="px-3 py-2 text-slate-400">—</td>
                <td class="px-3 py-2 text-slate-400">—</td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="mt-4">
    <% if @stripe_status[:complete] %>
      <button type="button" disabled class="rounded-md bg-amber-600 px-3 py-2 text-sm font-medium text-white opacity-50 cursor-not-allowed">All products configured</button>
    <% else %>
      <%= button_to "Setup Products & Prices", setup_stripe_admin_billing_path,
            method: :post,
            class: "rounded-md bg-amber-600 px-3 py-2 text-sm font-medium text-white hover:bg-amber-700",
            data: { turbo_confirm: "This will create missing Stripe products and prices. Continue?" } %>
    <% end %>
  </div>
</div>

<%# ── Billing Portal Configuration ── %>
<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center justify-between">
    <h3 class="text-sm font-semibold text-slate-900">Billing Portal Configuration</h3>
    <% if @portal_configuration_id.present? %>
      <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700">Configured</span>
    <% else %>
      <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700">Not configured</span>
    <% end %>
  </div>

  <div class="mt-3 text-sm text-slate-600">
    <% if @portal_configuration_id.present? %>
      <p>Configuration ID: <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-xs"><%= @portal_configuration_id %></code></p>
    <% else %>
      <p>No portal configuration ID found in credentials.</p>
    <% end %>
  </div>

  <div class="mt-4">
    <%= button_to "Configure Billing Portal", configure_portal_admin_billing_path,
          method: :post,
          class: "rounded-md bg-slate-800 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700",
          data: { turbo_confirm: "This will create a new Stripe Billing Portal configuration. Continue?" } %>
    <p class="mt-2 text-xs text-slate-500">After creation, add the configuration ID to Rails credentials under <code>stripe.portal_configuration_id</code>.</p>
  </div>
</div>

<%# ── Organization Plan Sync ── %>
<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center justify-between">
    <h3 class="text-sm font-semibold text-slate-900">Organization Plan Sync</h3>
    <span class="text-xs text-slate-500"><%= @organizations_with_subscriptions.size %> organization(s) with active subscriptions</span>
  </div>

  <div class="mt-4">
    <%= button_to "Sync All Organizations", sync_all_organizations_admin_billing_path,
          method: :post,
          class: "rounded-md bg-amber-600 px-3 py-2 text-sm font-medium text-white hover:bg-amber-700",
          data: { turbo_confirm: "This will sync all organization plans from Stripe. Continue?" } %>
  </div>

  <% if @organizations_with_subscriptions.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Organization</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Local Plan</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Stripe Price</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @organizations_with_subscriptions.each do |org| %>
            <% subscription = org.active_subscription %>
            <% processor_plan = subscription&.processor_plan %>
            <% expected_plan = processor_plan.present? ? PlanLimits::LOOKUP_KEYS[processor_plan] : nil %>
            <% mismatched = expected_plan.present? && expected_plan != org.plan %>
            <tr class="<%= 'bg-amber-50' if mismatched %>">
              <td class="px-3 py-2 font-medium text-slate-900"><%= org.name %></td>
              <td class="px-3 py-2"><%= org.plan.titleize %></td>
              <td class="px-3 py-2 font-mono text-xs"><%= processor_plan || "—" %></td>
              <% if mismatched %>
                <td class="px-3 py-2"><span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">⚠️ Mismatch</span></td>
              <% else %>
                <td class="px-3 py-2"><span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">✅ In sync</span></td>
              <% end %>
              <td class="px-3 py-2">
                <%= button_to "Sync", sync_organization_admin_billing_path(organization_id: org.id),
                      method: :post,
                      class: "rounded-md bg-slate-800 px-2 py-1 text-xs font-medium text-white hover:bg-slate-700",
                      data: { turbo_confirm: "Sync plan for #{org.name}?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-slate-500">No organizations with active subscriptions.</p>
  <% end %>
</div>

<%# ── Existing Stats (unchanged) ── %>
<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-3 text-sm">
    <div class="rounded-md bg-slate-50 p-3">
      <p class="text-slate-500">Active Subscriptions</p>
      <p class="mt-1 font-semibold text-slate-900"><%= @active_subscriptions.count %></p>
    </div>
    <div class="rounded-md bg-slate-50 p-3">
      <p class="text-slate-500">Revenue (Last 30 Days)</p>
      <p class="mt-1 font-semibold text-slate-900"><%= number_to_currency(@revenue_last_30_days_cents.to_f / 100.0) %></p>
    </div>
    <div class="rounded-md bg-slate-50 p-3">
      <p class="text-slate-500">Recent Charges</p>
      <p class="mt-1 font-semibold text-slate-900"><%= @recent_charges.count %></p>
    </div>
  </div>

  <h3 class="text-sm font-semibold text-slate-900">Organizations by Plan</h3>
  <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 text-sm">
    <% %w[free starter pro].each do |plan| %>
      <div class="rounded-md bg-slate-50 p-3">
        <p class="text-slate-500"><%= plan.titleize %></p>
        <p class="mt-1 font-semibold text-slate-900"><%= @plan_distribution[plan] || 0 %></p>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="text-sm font-semibold text-slate-900">Active Subscriptions</h3>
  <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Organization</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Plan</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Qty</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Period End</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @active_subscriptions.first(20).each do |subscription| %>
        <tr>
          <td class="px-3 py-2"><%= subscription.customer&.owner&.name || "n/a" %></td>
          <td class="px-3 py-2"><%= subscription.processor_plan %></td>
          <td class="px-3 py-2"><%= subscription.status %></td>
          <td class="px-3 py-2"><%= subscription.quantity %></td>
          <td class="px-3 py-2"><%= subscription.current_period_end&.to_date || "n/a" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="text-sm font-semibold text-slate-900">Recent Charges</h3>
  <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Organization</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Amount</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Currency</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @recent_charges.first(20).each do |charge| %>
        <tr>
          <td class="px-3 py-2"><%= charge.created_at.to_fs(:db) %></td>
          <td class="px-3 py-2"><%= charge.customer&.owner&.name || "n/a" %></td>
          <td class="px-3 py-2"><%= number_to_currency(charge.amount.to_f / 100.0) %></td>
          <td class="px-3 py-2"><%= charge.currency.to_s.upcase %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <h3 class="text-sm font-semibold text-slate-900">Recent Webhooks</h3>
  <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Event Type</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Processor</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @recent_webhooks.first(20).each do |webhook| %>
        <tr>
          <td class="px-3 py-2"><%= webhook.created_at.to_fs(:db) %></td>
          <td class="px-3 py-2"><%= webhook.event_type %></td>
          <td class="px-3 py-2"><%= webhook.processor %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
