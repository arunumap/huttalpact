<%= form_with model: [ :admin, @plan_tier ], class: "space-y-5" do |form| %>
  <% if @plan_tier.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700">
      <p class="font-medium">Please fix the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @plan_tier.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>

    <div>
      <%= form.label :slug, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :slug, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Stable internal identifier used on organizations and Stripe lookup mapping.</p>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :description, rows: 2, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-4">
    <div>
      <%= form.label :rank, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :rank, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :position, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :position, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :audit_log_days, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :audit_log_days, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Leave blank for full history.</p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <%= form.label :contract_limit, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :contract_limit, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Leave blank for unlimited.</p>
    </div>
    <div>
      <%= form.label :extraction_limit, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :extraction_limit, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Leave blank for unlimited.</p>
    </div>
    <div>
      <%= form.label :extraction_overage_cents, "Extraction Overage (cents)", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :extraction_overage_cents, min: 0, step: 1, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Set to 0 to disable overage billing.</p>
    </div>
    <div>
      <%= form.label :user_limit, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :user_limit, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      <p class="mt-1 text-xs text-slate-500">Leave blank for unlimited.</p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :monthly_price_cents, "Monthly Price (cents)", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :monthly_price_cents, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :annual_price_cents, "Annual Price (cents)", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :annual_price_cents, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :monthly_lookup_key, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :monthly_lookup_key, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :annual_lookup_key, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :annual_lookup_key, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
  </div>

  <div>
    <%= form.label :feature_list_text, "Feature List (one line per bullet)", class: "block text-sm font-medium text-slate-700" %>
    <%= text_area_tag "plan_tier[feature_list_text]", @plan_tier.feature_list.join("\n"), rows: 5, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
      <%= form.check_box :active, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
      Active
    </label>
    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
      <%= form.check_box :visible_on_pricing_page, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
      Visible on pricing page
    </label>
    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
      <%= form.check_box :featured, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
      Featured tier
    </label>
    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
      <%= form.check_box :default_tier, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
      Default tier
    </label>
    <label class="inline-flex items-center gap-2 text-sm text-slate-700 sm:col-span-2">
      <%= form.check_box :system_tier, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
      System tier (cannot be deleted/deactivated)
    </label>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    <%= link_to "Cancel", admin_plan_tiers_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
  </div>
<% end %>
