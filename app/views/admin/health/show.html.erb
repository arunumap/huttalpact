<% content_for :title, "Admin Health" %>
<% content_for :page_title, "Health" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <dl class="space-y-2 text-sm text-slate-700">
    <div class="flex justify-between"><dt>Database Connected</dt><dd><%= @database_connected ? "Yes" : "No" %></dd></div>
    <div class="flex justify-between"><dt>Rails Version</dt><dd><%= @rails_version %></dd></div>
    <div class="flex justify-between"><dt>Ruby Version</dt><dd><%= @ruby_version %></dd></div>
    <div class="flex justify-between"><dt>Environment</dt><dd><%= @environment %></dd></div>
    <div class="flex justify-between"><dt>Sentry Initialized</dt><dd><%= @sentry_initialized ? "Yes" : "No" %></dd></div>
    <div class="flex justify-between"><dt>Queue Processes</dt><dd><%= @solid_queue_process_count %></dd></div>
    <div class="flex justify-between"><dt>Healthy Queue Processes</dt><dd><%= @solid_queue_healthy_process_count %></dd></div>
    <div class="flex justify-between"><dt>Pending Jobs</dt><dd><%= @solid_queue_pending_count %></dd></div>
    <div class="flex justify-between"><dt>Failed Jobs</dt><dd><%= @solid_queue_failed_count %></dd></div>
  </dl>
</div>
