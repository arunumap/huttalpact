<% content_for :title, "New AI Config — #{@config.extraction_type.titleize}" %>
<% content_for :page_title, "New Config Version: #{@config.extraction_type.titleize}" %>

<div class="mx-auto max-w-2xl">
  <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <%= form_with model: @config, url: admin_ai_extraction_configs_path, class: "space-y-5",
                  data: { controller: "model-select", "model-select-pricing-value": AiExtractionConfig.model_pricing_json.to_json } do |form| %>
      <%= form.hidden_field :extraction_type %>

      <% if @config.errors.any? %>
        <div class="rounded-md bg-red-50 p-3">
          <ul class="text-sm text-red-700 list-disc list-inside">
            <% @config.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-medium text-slate-700">Extraction Type</label>
        <p class="mt-1 text-sm font-semibold text-slate-900"><%= @config.extraction_type.titleize %></p>
      </div>

      <div>
        <%= form.label :ai_model, "AI Model", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :ai_model,
            AiExtractionConfig.model_options_for_select,
            { include_blank: "— Select a model —" },
            class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
            data: { action: "change->model-select#updatePricing" } %>
        <p class="mt-1 text-xs text-slate-500">The Anthropic model to use for this extraction type.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :max_tokens, "Max Tokens", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :max_tokens, min: 1, step: 1,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm" %>
          <p class="mt-1 text-xs text-slate-500">Maximum output tokens for the API response.</p>
        </div>
        <div>
          <%= form.label :temperature, "Temperature", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :temperature, min: 0.0, max: 1.0, step: 0.01,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
              placeholder: "Leave blank for API default" %>
          <p class="mt-1 text-xs text-slate-500">0.0 = deterministic, 1.0 = creative. Blank uses API default.</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :top_p, "Top P", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :top_p, min: 0.0, max: 1.0, step: 0.01,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
              placeholder: "Leave blank for API default" %>
          <p class="mt-1 text-xs text-slate-500">Nucleus sampling. Blank uses API default.</p>
        </div>
        <div>
          <%= form.label :top_k, "Top K", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :top_k, min: 1, step: 1,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
              placeholder: "Leave blank for API default" %>
          <p class="mt-1 text-xs text-slate-500">Top-k sampling. Blank uses API default.</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :input_cost_per_million, "Input Cost per 1M Tokens ($)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :input_cost_per_million, min: 0.0001, step: 0.0001,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
              data: { "model-select-target": "inputCost" } %>
        </div>
        <div>
          <%= form.label :output_cost_per_million, "Output Cost per 1M Tokens ($)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.number_field :output_cost_per_million, min: 0.0001, step: 0.0001,
              class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
              data: { "model-select-target": "outputCost" } %>
        </div>
      </div>

      <div>
        <%= form.label :notes, "Notes", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :notes, rows: 3,
            class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-600 focus:ring-indigo-600 sm:text-sm",
            placeholder: "Describe what changed in this version..." %>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" name="activate" value="1" id="activate_checkbox"
               class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-600">
        <label for="activate_checkbox" class="text-sm font-medium text-slate-700">Activate immediately</label>
        <span class="text-xs text-slate-500">(makes this version live for all new extractions)</span>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= form.submit "Create Version", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
        <%= link_to "Cancel", admin_ai_extraction_configs_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
      </div>
    <% end %>
  </div>
</div>
