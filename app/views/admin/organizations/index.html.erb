<% content_for :title, "Admin Organizations" %>
<% content_for :page_title, "Organizations" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <% plan_options = [["All plans", ""]] + PlanCatalogService.available_plan_slugs.map { |slug| [slug.titleize, slug] } %>

  <%= form_with url: admin_organizations_path, method: :get, class: "mb-4 grid grid-cols-1 gap-2 sm:grid-cols-3" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Search name or slug", class: "rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <%= form.select :plan, options_for_select(plan_options, params[:plan]), {}, class: "rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    <%= form.submit "Filter", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Name</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Slug</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Plan</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Contracts</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @organizations.each do |organization| %>
          <tr>
            <td class="px-3 py-2"><%= link_to organization.name, admin_organization_path(organization), class: "font-medium text-indigo-700 hover:text-indigo-600" %></td>
            <td class="px-3 py-2"><%= organization.slug %></td>
            <td class="px-3 py-2"><%= organization.plan.titleize %></td>
            <td class="px-3 py-2"><%= organization.contracts_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
