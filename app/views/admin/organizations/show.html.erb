<% content_for :title, "Admin Organization" %>
<% content_for :page_title, @organization.name %>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Organization</h3>
    <dl class="mt-3 space-y-2 text-sm text-slate-700">
      <div class="flex justify-between"><dt>Slug</dt><dd><%= @organization.slug %></dd></div>
      <div class="flex justify-between"><dt>Plan</dt><dd><%= @organization.plan.titleize %></dd></div>
      <div class="flex justify-between"><dt>Contracts</dt><dd><%= @organization.contracts_count %></dd></div>
      <div class="flex justify-between"><dt>AI Extractions Count</dt><dd><%= @organization.ai_extractions_count %></dd></div>
    </dl>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Members</h3>
    <% if @memberships.any? %>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <% @memberships.each do |membership| %>
          <li><%= membership.user.full_name %> · <%= membership.user.email_address %> · <%= membership.role.titleize %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No members found for this organization.</p>
    <% end %>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
    <h3 class="text-sm font-semibold text-slate-900">Recent Contracts</h3>
    <% if @recent_contracts.any? %>
      <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Title</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @recent_contracts.each do |contract| %>
            <tr>
              <td class="px-3 py-2"><%= contract.title %></td>
              <td class="px-3 py-2"><%= contract.status.to_s.humanize %></td>
              <td class="px-3 py-2"><%= contract.created_at.to_date %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No contracts found.</p>
    <% end %>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
    <h3 class="text-sm font-semibold text-slate-900">Recent AI Usage</h3>
    <% if @recent_ai_usage.any? %>
      <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Model</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Tokens</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @recent_ai_usage.each do |log| %>
            <tr>
              <td class="px-3 py-2"><%= log.created_at.to_fs(:db) %></td>
              <td class="px-3 py-2"><%= log.ai_model %></td>
              <td class="px-3 py-2"><%= number_with_delimiter(log.total_tokens) %></td>
              <td class="px-3 py-2"><%= log.success? ? "Success" : "Failed" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No AI usage has been logged yet.</p>
    <% end %>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">Pending Invitations</h3>
    <% if @pending_invitations.any? %>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <% @pending_invitations.each do |invitation| %>
          <li><%= invitation.email %> · <%= invitation.role.titleize %> · expires <%= invitation.expires_at.to_date %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No pending invitations.</p>
    <% end %>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
    <h3 class="text-sm font-semibold text-slate-900">Recent Activity</h3>
    <% if @recent_activity.any? %>
      <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">When</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">User</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @recent_activity.each do |log| %>
            <tr>
              <td class="px-3 py-2"><%= log.created_at.to_fs(:db) %></td>
              <td class="px-3 py-2"><%= log.user&.email_address || "System" %></td>
              <td class="px-3 py-2"><%= log.action.to_s.humanize %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No recent activity found.</p>
    <% end %>
  </div>
</div>
