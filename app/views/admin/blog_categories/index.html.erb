<% content_for :title, "Admin Blog Categories" %>
<% content_for :page_title, "Blog Categories" %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-1 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">New Category</h3>
    <%= form_with model: [ :admin, @blog_category ], class: "mt-4 space-y-3", local: true do |form| %>
      <% if @blog_category.errors.any? %>
        <div class="rounded-md bg-red-50 p-3">
          <ul class="list-inside list-disc text-sm text-red-700">
            <% @blog_category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :slug, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :slug, placeholder: "auto-generated-if-blank", class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :position, class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :position, min: 0, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
      </div>

      <%= form.submit "Create Category", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="lg:col-span-2 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Name</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Slug</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Position</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Posts</th>
          <th class="px-3 py-2 text-right font-medium text-slate-600">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @categories.each do |category| %>
          <tr>
            <td class="px-3 py-2 font-medium text-slate-900"><%= category.name %></td>
            <td class="px-3 py-2 text-slate-700"><%= category.slug %></td>
            <td class="px-3 py-2 text-slate-700"><%= category.position %></td>
            <td class="px-3 py-2 text-slate-700"><%= category.blog_posts.count %></td>
            <td class="px-3 py-2 text-right">
              <%= link_to "Edit", edit_admin_blog_category_path(category), class: "text-indigo-700 hover:text-indigo-600" %>
              <span class="mx-1 text-slate-300">|</span>
              <%= button_to "Delete", admin_blog_category_path(category), method: :delete, form: { class: "inline", data: { turbo_confirm: "Delete this category?" } }, class: "text-red-700 hover:text-red-600" %>
            </td>
          </tr>
        <% end %>
        <% if @categories.empty? %>
          <tr>
            <td colspan="5" class="px-3 py-8 text-center text-slate-500">No categories yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>