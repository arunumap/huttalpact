<% content_for :title, "Failed Jobs" %>
<% content_for :page_title, "Failed Jobs" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">ID</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Job Class</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Queue</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Failed At</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @failed_executions.each do |execution| %>
        <tr>
          <td class="px-3 py-2"><%= link_to execution.id, admin_job_path(execution.id), class: "text-indigo-700 hover:text-indigo-600" %></td>
          <td class="px-3 py-2"><%= execution.job&.class_name %></td>
          <td class="px-3 py-2"><%= execution.job&.queue_name %></td>
          <td class="px-3 py-2"><%= execution.created_at.to_fs(:db) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
