<% content_for :title, "Admin Jobs" %>
<% content_for :page_title, "Jobs" %>

<div class="space-y-4">
  <% unless @solid_queue_available %>
    <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
      <p class="text-sm text-slate-600">Solid Queue is not available in this environment.</p>
    </div>
  <% else %>
    <%# ── Summary Cards ── %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 text-sm">
      <% %w[all pending running scheduled failed completed].each do |status| %>
        <% active = @status_filter == status %>
        <%= link_to admin_jobs_path(status: status, job_class: params[:job_class]),
              class: "rounded-lg p-3 ring-1 transition block #{active ? 'bg-amber-50 ring-amber-400 shadow' : 'bg-white ring-slate-200 hover:ring-slate-300'}" do %>
          <p class="text-xs font-medium uppercase tracking-wide <%= active ? 'text-amber-700' : 'text-slate-500' %>"><%= status.titleize %></p>
          <p class="mt-1 text-lg font-bold <%= active ? 'text-amber-900' : 'text-slate-900' %>"><%= @counts[status.to_sym] %></p>
        <% end %>
      <% end %>
    </div>

    <%# ── Filters Row ── %>
    <div class="flex flex-wrap items-center gap-3">
      <% if @job_classes.any? %>
        <form method="get" action="<%= admin_jobs_path %>" class="flex items-center gap-2">
          <input type="hidden" name="status" value="<%= @status_filter %>">
          <select name="job_class" onchange="this.form.submit()"
                  class="rounded-md border-slate-300 bg-white py-1.5 pl-3 pr-8 text-sm text-slate-700 shadow-sm focus:border-amber-500 focus:ring-amber-500">
            <option value="">All Job Classes</option>
            <% @job_classes.each do |klass| %>
              <option value="<%= klass %>" <%= 'selected' if params[:job_class] == klass %>><%= klass %></option>
            <% end %>
          </select>
        </form>
      <% end %>

      <div class="ml-auto flex gap-2">
        <%= link_to "Recurring Tasks", recurring_admin_jobs_path,
              class: "rounded-md bg-slate-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-600" %>
      </div>
    </div>

    <%# ── Jobs Table ── %>
    <div class="rounded-lg bg-white shadow-sm ring-1 ring-slate-200 overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">ID</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Job Class</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Queue</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Created</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <% if @jobs.empty? %>
            <tr>
              <td colspan="6" class="px-3 py-8 text-center text-sm text-slate-400">No jobs found for this filter.</td>
            </tr>
          <% end %>
          <% @jobs.each do |job| %>
            <% status = job_status(job) %>
            <% failed_exec = @failed_map[job.id] %>
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-2">
                <%= link_to job.id, admin_job_path(job.id), class: "text-amber-700 hover:text-amber-600 font-medium" %>
              </td>
              <td class="px-3 py-2 font-mono text-xs"><%= job.class_name %></td>
              <td class="px-3 py-2"><%= job.queue_name %></td>
              <td class="px-3 py-2">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= job_status_badge_class(status) %>">
                  <%= status.titleize %>
                </span>
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-slate-500"><%= job.created_at.to_fs(:db) %></td>
              <td class="max-w-xs truncate px-3 py-2 text-xs text-red-600">
                <% if failed_exec %>
                  <span title="<%= h(failed_exec.error.to_s.first(500)) %>">
                    <%= failed_exec.error.to_s.first(120) %>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="mt-2"><%== pagy_nav(@pagy) %></div>
    <% end %>

    <%# ── Worker Processes ── %>
    <details class="rounded-lg bg-white shadow-sm ring-1 ring-slate-200" open>
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-900">
        Worker Processes (<%= @processes.size %>)
      </summary>
      <div class="overflow-x-auto border-t border-slate-200">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left font-medium text-slate-600">Name</th>
              <th class="px-3 py-2 text-left font-medium text-slate-600">Host</th>
              <th class="px-3 py-2 text-left font-medium text-slate-600">PID</th>
              <th class="px-3 py-2 text-left font-medium text-slate-600">Heartbeat</th>
              <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @processes.each do |process| %>
              <% healthy = process.last_heartbeat_at.present? && process.last_heartbeat_at > 5.minutes.ago %>
              <tr>
                <td class="px-3 py-2"><%= process.name %></td>
                <td class="px-3 py-2"><%= process.hostname %></td>
                <td class="px-3 py-2"><%= process.pid %></td>
                <td class="px-3 py-2"><%= process.last_heartbeat_at&.to_fs(:db) || "n/a" %></td>
                <td class="px-3 py-2">
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= healthy ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                    <%= healthy ? "Healthy" : "Stale" %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% end %>
</div>
