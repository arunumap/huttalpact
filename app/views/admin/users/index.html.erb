<% content_for :title, "Admin Users" %>
<% content_for :page_title, "Users" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <%= form_with url: admin_users_path, method: :get, class: "mb-4" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Search by name or email", class: "w-full rounded-md border-slate-300 text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-indigo-600" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Name</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Email</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Organizations</th>
          <th class="px-3 py-2 text-left font-medium text-slate-600">Created</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @users.each do |user| %>
          <tr>
            <td class="px-3 py-2"><%= link_to user.full_name, admin_user_path(user), class: "font-medium text-indigo-700 hover:text-indigo-600" %></td>
            <td class="px-3 py-2"><%= user.email_address %></td>
            <td class="px-3 py-2"><%= user.organizations.count %></td>
            <td class="px-3 py-2"><%= user.created_at.to_date %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
