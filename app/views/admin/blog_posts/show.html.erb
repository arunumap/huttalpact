<% content_for :title, "Blog Post: #{@blog_post.title}" %>
<% content_for :page_title, "Blog Post" %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <h3 class="text-lg font-semibold text-slate-900"><%= @blog_post.title %></h3>
    <p class="text-sm text-slate-500">/<%= @blog_post.slug %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Edit", edit_admin_blog_post_path(@blog_post), class: "rounded-md bg-slate-100 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200" %>
    <% if @blog_post.status == "published" %>
      <%= button_to "Unpublish", unpublish_admin_blog_post_path(@blog_post), method: :post, class: "rounded-md bg-amber-600 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-500" %>
    <% else %>
      <%= button_to "Publish", publish_admin_blog_post_path(@blog_post), method: :post, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    <% end %>
    <%= button_to "Delete", admin_blog_post_path(@blog_post), method: :delete, form: { data: { turbo_confirm: "Delete this post?" } }, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500" %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-1">
    <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
      <h4 class="text-sm font-semibold text-slate-900">Metadata</h4>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Status</dt><dd class="font-medium text-slate-900"><%= @blog_post.status.titleize %></dd></div>
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Category</dt><dd class="font-medium text-slate-900"><%= @blog_post.blog_category&.name || "—" %></dd></div>
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Author</dt><dd class="font-medium text-slate-900"><%= @blog_post.admin_user&.full_name || "—" %></dd></div>
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Published</dt><dd class="font-medium text-slate-900"><%= @blog_post.published_at&.to_fs(:short) || "—" %></dd></div>
      </dl>
    </div>
    <% if @blog_post.featured_image.attached? %>
      <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
        <h4 class="text-sm font-semibold text-slate-900">Featured image</h4>
        <%= image_tag @blog_post.featured_image, alt: @blog_post.title, class: "mt-3 w-full rounded-md border border-slate-200" %>
      </div>
    <% end %>
  </div>

  <div class="lg:col-span-2 rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <article class="prose prose-slate max-w-none">
      <%= render_blog_markdown(@blog_post) %>
    </article>
  </div>
</div>