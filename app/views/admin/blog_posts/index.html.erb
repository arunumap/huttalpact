<% content_for :title, "Admin Blog Posts" %>
<% content_for :page_title, "Blog Posts" %>

<div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <%= form_with url: admin_blog_posts_path, method: :get, class: "grid gap-3 sm:grid-cols-4" do |form| %>
    <div class="sm:col-span-2">
      <%= form.label :query, "Search", class: "block text-xs font-medium text-slate-600" %>
      <%= form.text_field :query, value: @query, placeholder: "Title contains...",
          class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :status, "Status", class: "block text-xs font-medium text-slate-600" %>
      <%= form.select :status,
          options_for_select([["All", ""]] + BlogPost::STATUSES.map { |status| [status.titleize, status] }, @status),
          {},
          class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div>
      <%= form.label :category_id, "Category", class: "block text-xs font-medium text-slate-600" %>
      <%= form.select :category_id,
          options_for_select([["All", ""]] + @categories.map { |category| [category.name, category.id] }, @category_id),
          {},
          class: "mt-1 block w-full rounded-md border-slate-300 text-sm focus:border-indigo-600 focus:ring-indigo-600" %>
    </div>
    <div class="sm:col-span-4 flex items-center justify-between">
      <%= form.submit "Filter", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to "New Post", new_admin_blog_post_path, class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    </div>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Title</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Status</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Category</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Published</th>
        <th class="px-3 py-2 text-left font-medium text-slate-600">Author</th>
        <th class="px-3 py-2 text-right font-medium text-slate-600">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 bg-white">
      <% @blog_posts.each do |post| %>
        <tr>
          <td class="px-3 py-2">
            <p class="font-medium text-slate-900"><%= link_to post.title, admin_blog_post_path(post), class: "hover:text-indigo-600" %></p>
            <p class="text-xs text-slate-500">/<%= post.slug %></p>
          </td>
          <td class="px-3 py-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= post.status == 'published' ? 'bg-green-100 text-green-700' : (post.status == 'archived' ? 'bg-slate-100 text-slate-700' : 'bg-amber-100 text-amber-700') %>"><%= post.status.titleize %></span>
          </td>
          <td class="px-3 py-2 text-slate-700"><%= post.blog_category&.name || "—" %></td>
          <td class="px-3 py-2 text-slate-700"><%= post.published_at&.to_fs(:short) || "—" %></td>
          <td class="px-3 py-2 text-slate-700"><%= post.admin_user&.full_name || "—" %></td>
          <td class="px-3 py-2 text-right">
            <div class="inline-flex items-center gap-3">
              <%= link_to "View", admin_blog_post_path(post), class: "text-indigo-700 hover:text-indigo-600" %>
              <%= link_to "Edit", edit_admin_blog_post_path(post), class: "text-slate-700 hover:text-slate-900" %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @blog_posts.empty? %>
        <tr>
          <td colspan="6" class="px-3 py-8 text-center text-slate-500">No blog posts found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-4"><%== pagy_nav(@pagy) %></div>
<% end %>