<% content_for :title, "Admin Storage" %>
<% content_for :page_title, "Storage" %>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Blobs</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @blob_count %></p>
  </div>
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Total Size</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= number_to_human_size(@total_bytes) %></p>
  </div>
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Orphaned Blobs</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900"><%= @orphaned_blob_count %></p>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
    <h3 class="text-sm font-semibold text-slate-900">Storage by Content Type</h3>
    <% if @by_content_type.any? %>
      <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Content Type</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Bytes</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Size</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @by_content_type.each do |content_type, bytes| %>
            <tr>
              <td class="px-3 py-2"><%= content_type.presence || "unknown" %></td>
              <td class="px-3 py-2"><%= number_with_delimiter(bytes) %></td>
              <td class="px-3 py-2"><%= number_to_human_size(bytes) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No blobs are stored yet.</p>
    <% end %>
  </div>

  <div class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200 overflow-x-auto">
    <h3 class="text-sm font-semibold text-slate-900">Largest Blobs</h3>
    <% if @largest_blobs.any? %>
      <table class="mt-3 min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Filename</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Type</th>
            <th class="px-3 py-2 text-left font-medium text-slate-600">Size</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @largest_blobs.each do |blob| %>
            <tr>
              <td class="px-3 py-2"><%= blob.filename.to_s %></td>
              <td class="px-3 py-2"><%= blob.content_type.presence || "unknown" %></td>
              <td class="px-3 py-2"><%= number_to_human_size(blob.byte_size) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No blob metadata available.</p>
    <% end %>
  </div>
</div>
