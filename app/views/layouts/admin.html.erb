<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "PactBadger Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= seo_meta_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div class="min-h-screen lg:flex" data-controller="admin-sidebar">
      <%# Mobile overlay %>
      <div data-admin-sidebar-target="overlay" data-action="click->admin-sidebar#close" class="hidden fixed inset-0 z-30 bg-gray-900/50 lg:hidden"></div>

      <%# Sidebar — drawer on mobile, static on desktop %>
      <aside data-admin-sidebar-target="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full bg-slate-800 text-white transition-transform duration-200 lg:static lg:translate-x-0">
        <div class="border-b border-slate-700 px-4 py-4 flex items-center justify-between">
          <h1 class="text-lg font-semibold">PactBadger Admin</h1>
          <button data-action="click->admin-sidebar#close" type="button" class="lg:hidden rounded-md p-1 text-slate-400 hover:text-white" aria-label="Close menu">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="space-y-1 px-3 py-4">
          <%= admin_sidebar_link_to "Dashboard", admin_root_path %>
          <%= admin_sidebar_link_to "Users", admin_users_path %>
          <%= admin_sidebar_link_to "Admin Users", admin_admin_users_path %>
          <%= admin_sidebar_link_to "Organizations", admin_organizations_path %>
          <%= admin_sidebar_link_to "AI Usage", admin_ai_usage_index_path %>
          <%= admin_sidebar_link_to "Review Learning", admin_review_learning_insights_path %>
          <%= admin_sidebar_link_to "AI Config", admin_ai_extraction_configs_path %>
          <%= admin_sidebar_link_to "Jobs", admin_jobs_path %>
          <%= admin_sidebar_link_to "Billing", admin_billing_path %>
          <%= admin_sidebar_link_to "Plan Tiers", admin_plan_tiers_path %>
          <%= admin_sidebar_link_to "Audit Logs", admin_audit_logs_path %>
          <%= admin_sidebar_link_to "Blog Posts", admin_blog_posts_path %>
          <%= admin_sidebar_link_to "Blog Categories", admin_blog_categories_path %>
          <%= admin_sidebar_link_to "Storage", admin_storage_path %>
          <%= admin_sidebar_link_to "Health", admin_health_path %>
        </nav>
      </aside>

      <main class="flex-1 p-4 sm:p-6">
        <header class="mb-6 flex items-center justify-between rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
          <div class="flex items-center gap-3">
            <%# Mobile hamburger %>
            <button data-action="click->admin-sidebar#toggle" type="button" class="lg:hidden rounded-md p-1 text-slate-500 hover:text-slate-700" aria-label="Open menu">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
            <div>
              <h2 class="text-lg font-semibold text-slate-900"><%= content_for(:page_title) || "Admin Portal" %></h2>
              <% if current_admin %>
                <p class="text-sm text-slate-500"><%= current_admin.email_address %></p>
              <% end %>
            </div>
          </div>
          <%= button_to "Sign out", admin_session_path, method: :delete, class: "rounded-md bg-slate-800 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </header>

        <% if flash[:alert] %>
          <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-700"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="mb-4 rounded-md bg-green-50 p-3 text-sm text-green-700"><%= flash[:notice] %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
