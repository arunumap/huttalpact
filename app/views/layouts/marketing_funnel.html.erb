<!DOCTYPE html>
<html class="h-full bg-white">
  <head>
    <title><%= content_for(:title) || "PactBadger — Contract Tracking" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PactBadger">
    <%= seo_meta_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/google_analytics" %>
  </head>

  <body class="h-full bg-white text-gray-900">
    <nav class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <%= link_to root_path, class: "flex items-center" do %>
          <%= image_tag "pact_badger_log.svg", alt: "PactBadger", class: "h-12 w-auto" %>
        <% end %>

        <%= link_to "Sign In", new_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>
    </nav>

    <main>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-white py-8">
      <div class="mx-auto flex max-w-6xl items-center justify-center gap-6 px-4 text-sm text-gray-500 sm:px-6 lg:px-8">
        <%= link_to "Privacy", privacy_path, class: "hover:text-gray-700" %>
        <%= link_to "Terms", terms_path, class: "hover:text-gray-700" %>
      </div>
    </footer>
  </body>
</html>
