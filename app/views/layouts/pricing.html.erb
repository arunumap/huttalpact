<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Pricing — PactBadger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PactBadger">
    <%= seo_meta_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/google_analytics" %>
  </head>

  <body class="h-full font-['Inter',sans-serif] antialiased">
    <%# Sticky glass navigation %>
    <nav class="fixed top-0 inset-x-0 z-50 nav-glass border-b border-gray-200/50 transition-all duration-300"
         data-controller="sticky-nav mobile-nav">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <% if Current.user %>
            <%= link_to dashboard_path, class: "flex items-center" do %>
              <%= image_tag "pact_badger_log.svg", alt: "PactBadger", class: "h-10 w-auto" %>
            <% end %>
          <% else %>
            <%= link_to root_path, class: "flex items-center" do %>
              <%= image_tag "pact_badger_log.svg", alt: "PactBadger", class: "h-10 w-auto" %>
            <% end %>
          <% end %>

          <%# Desktop nav %>
          <div class="hidden sm:flex items-center gap-6">
            <% if Current.user %>
              <%= link_to "← Dashboard", dashboard_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            <% end %>
            <%= link_to "Leases", leases_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            <%= link_to "Blog", blog_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            <% unless Current.user %>
              <div class="h-4 w-px bg-gray-200"></div>
              <%= link_to "Sign In", new_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
              <%= link_to "Start Free", new_registration_path,
                  class: "rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800 shadow-sm hover:shadow-md transition-all duration-200" %>
            <% end %>
          </div>

          <%# Mobile hamburger %>
          <button data-action="click->mobile-nav#toggle" type="button"
                  class="sm:hidden inline-flex items-center justify-center rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors"
                  aria-label="Open menu">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
        </div>

        <%# Mobile menu %>
        <div data-mobile-nav-target="menu" class="hidden sm:hidden border-t border-gray-200/50 py-4 space-y-1">
          <% if Current.user %>
            <%= link_to "← Dashboard", dashboard_path, class: "block rounded-lg px-3 py-2.5 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" %>
          <% end %>
          <%= link_to "Leases", leases_path, class: "block rounded-lg px-3 py-2.5 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" %>
          <%= link_to "Blog", blog_path, class: "block rounded-lg px-3 py-2.5 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" %>
          <% unless Current.user %>
            <%= link_to "Sign In", new_session_path, class: "block rounded-lg px-3 py-2.5 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" %>
            <div class="pt-2">
              <%= link_to "Start Free", new_registration_path,
                  class: "block rounded-lg px-3 py-2.5 text-base font-semibold text-white bg-gray-900 hover:bg-gray-800 text-center transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <%# Spacer for fixed nav %>
    <div class="h-16"></div>

    <%# Flash messages %>
    <% if flash[:notice] %>
      <div data-controller="flash" role="alert" aria-live="polite"
           class="mx-auto max-w-5xl mt-4 px-4 sm:px-6 flex items-start gap-3 rounded-lg bg-green-50 p-4 ring-1 ring-green-200/50">
        <svg class="h-5 w-5 shrink-0 text-green-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <p class="flex-1 text-sm text-green-700"><%= sanitize flash[:notice], tags: %w[a strong], attributes: %w[href class] %></p>
        <button data-action="click->flash#dismiss" type="button" class="shrink-0 rounded-md text-green-500 hover:text-green-700 focus:outline-none">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
        </button>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div data-controller="flash" role="alert" aria-live="assertive"
           class="mx-auto max-w-5xl mt-4 px-4 sm:px-6 flex items-start gap-3 rounded-lg bg-red-50 p-4 ring-1 ring-red-200/50">
        <svg class="h-5 w-5 shrink-0 text-red-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <p class="flex-1 text-sm text-red-700"><%= sanitize flash[:alert], tags: %w[a strong], attributes: %w[href class] %></p>
        <button data-action="click->flash#dismiss" type="button" class="shrink-0 rounded-md text-red-500 hover:text-red-700 focus:outline-none">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
        </button>
      </div>
    <% end %>

    <%# Page content %>
    <main>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
