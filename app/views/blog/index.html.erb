<% content_for :title, "Blog — Contract Management Insights | PactBadger" %>
<% content_for :meta_description, "Contract management insights, AI extraction tips, and product updates from PactBadger." %>
<% content_for :canonical_url, blog_url %>

<%# ── Header ── %>
<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white border-b border-gray-200/50">
  <div class="absolute inset-0 bg-grid opacity-30"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-800 ring-1 ring-amber-200/60">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      PactBadger Blog
    </div>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Contract insights for growing teams</h1>
    <p class="mt-4 max-w-3xl text-lg text-gray-600">Practical guidance on renewals, clauses, compliance, and workflow automation.</p>
  </div>
</section>

<%# ── Content ── %>
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8" data-controller="scroll-animate">
  <% if @categories.any? %>
    <div class="mb-10 flex flex-wrap gap-2">
      <%= link_to "All", blog_path,
          class: "inline-flex items-center rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-200 #{@selected_category.nil? ? 'bg-gray-900 text-white shadow-sm' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, blog_path(category: category.slug),
            class: "inline-flex items-center rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-200 #{@selected_category == category ? 'bg-gray-900 text-white shadow-sm' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @blog_posts.any? %>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% @blog_posts.each_with_index do |post, i| %>
        <article class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200/60 hover:shadow-md hover:ring-gray-300 transition-all duration-300 animate-on-scroll stagger-delay-<%= (i % 3) + 1 %>">
          <% if post.featured_image.attached? %>
            <%= link_to blog_post_path(post.slug), class: "block overflow-hidden" do %>
              <%= image_tag post.featured_image, alt: post.title, class: "h-52 w-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            <% end %>
          <% else %>
            <%= link_to blog_post_path(post.slug), class: "block h-52 bg-gradient-to-br from-amber-50 via-orange-50 to-amber-100 overflow-hidden" do %>
              <div class="flex h-full items-center justify-center">
                <%= image_tag "pact_badger_log.svg", alt: "PactBadger", class: "h-12 w-auto opacity-40" %>
              </div>
            <% end %>
          <% end %>

          <div class="p-6">
            <% if post.blog_category %>
              <span class="inline-flex items-center rounded-full bg-amber-100/80 px-2.5 py-0.5 text-xs font-semibold text-amber-800"><%= post.blog_category.name %></span>
            <% end %>

            <h2 class="mt-3 text-lg font-bold text-gray-900 leading-snug">
              <%= link_to post.title, blog_post_path(post.slug), class: "hover:text-amber-700 transition-colors" %>
            </h2>

            <p class="mt-2 text-sm text-gray-600 line-clamp-3"><%= post.display_excerpt %></p>

            <div class="mt-4 flex items-center justify-between text-xs text-gray-400">
              <span><%= post.published_on.strftime("%b %-d, %Y") %></span>
              <span><%= pluralize(post.reading_time, "min") %> read</span>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-12 flex justify-center">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      <h2 class="mt-4 text-lg font-semibold text-gray-900">No posts yet</h2>
      <p class="mt-2 text-sm text-gray-600">Check back soon for contract tips, AI workflows, and product updates.</p>
    </div>
  <% end %>
</section>
