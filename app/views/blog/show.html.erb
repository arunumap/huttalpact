<% content_for :title, "#{@blog_post.title} — PactBadger Blog" %>
<% content_for :meta_description, (@blog_post.meta_description.presence || @blog_post.display_excerpt) %>
<% content_for :canonical_url, (@blog_post.canonical_url.presence || blog_post_url(@blog_post.slug)) %>
<% content_for :og_type, "article" %>
<% content_for :og_image, blog_post_og_image(@blog_post) %>

<%= structured_data(type: :blog_posting, post: @blog_post, canonical_url: (@blog_post.canonical_url.presence || blog_post_url(@blog_post.slug)), image_url: blog_post_og_image(@blog_post)) %>
<%= structured_data(type: :breadcrumb, items: [
  { name: "Home", url: root_url },
  { name: "Blog", url: blog_url },
  { name: @blog_post.title, url: blog_post_url(@blog_post.slug) }
]) %>

<section class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="text-sm text-gray-500">
      <%= link_to "Blog", blog_path, class: "hover:text-gray-700" %>
      <span class="mx-2">/</span>
      <% if @blog_post.blog_category %>
        <%= link_to @blog_post.blog_category.name, blog_path(category: @blog_post.blog_category.slug), class: "hover:text-gray-700" %>
        <span class="mx-2">/</span>
      <% end %>
      <span class="text-gray-700"><%= @blog_post.title %></span>
    </p>

    <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900"><%= @blog_post.title %></h1>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-600">
      <span><%= @blog_post.published_on.strftime("%B %-d, %Y") %></span>
      <span>•</span>
      <span><%= pluralize(@blog_post.reading_time, "min") %> read</span>
      <span>•</span>
      <span><%= @blog_post.admin_user&.full_name || "PactBadger Team" %></span>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <% if @blog_post.featured_image.attached? %>
    <%= image_tag @blog_post.featured_image, alt: @blog_post.title, class: "mb-8 w-full rounded-xl border border-gray-200 object-cover" %>
  <% end %>

  <article class="prose prose-gray prose-lg max-w-none">
    <%= render_blog_markdown(@blog_post) %>
  </article>

  <div class="mt-12 grid gap-4 border-t border-gray-200 pt-8 sm:grid-cols-2">
    <div>
      <% if @previous_post %>
        <p class="text-xs uppercase tracking-wide text-gray-500">Previous</p>
        <%= link_to @previous_post.title, blog_post_path(@previous_post.slug), class: "mt-1 block text-sm font-semibold text-gray-900 hover:text-amber-700" %>
      <% end %>
    </div>
    <div class="text-left sm:text-right">
      <% if @next_post %>
        <p class="text-xs uppercase tracking-wide text-gray-500">Next</p>
        <%= link_to @next_post.title, blog_post_path(@next_post.slug), class: "mt-1 block text-sm font-semibold text-gray-900 hover:text-amber-700" %>
      <% end %>
    </div>
  </div>

  <div class="mt-12 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-center sm:p-8">
    <h2 class="text-2xl font-bold text-gray-900">Ready to track your contracts smarter?</h2>
    <p class="mt-2 text-sm text-gray-600">Upload contracts, extract key clauses, and never miss a deadline.</p>
    <div class="mt-5">
      <%= link_to "Start free", new_registration_path, class: "inline-flex items-center rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-500" %>
    </div>
  </div>
</section>