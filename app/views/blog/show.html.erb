<% content_for :title, "#{@blog_post.title} — PactBadger Blog" %>
<% content_for :meta_description, (@blog_post.meta_description.presence || @blog_post.display_excerpt) %>
<% content_for :canonical_url, (@blog_post.canonical_url.presence || blog_post_url(@blog_post.slug)) %>
<% content_for :og_type, "article" %>
<% content_for :og_image, blog_post_og_image(@blog_post) %>

<%= structured_data(type: :blog_posting, post: @blog_post, canonical_url: (@blog_post.canonical_url.presence || blog_post_url(@blog_post.slug)), image_url: blog_post_og_image(@blog_post)) %>
<%= structured_data(type: :breadcrumb, items: [
  { name: "Home", url: root_url },
  { name: "Blog", url: blog_url },
  { name: @blog_post.title, url: blog_post_url(@blog_post.slug) }
]) %>

<%# ── Header ── %>
<section class="relative overflow-hidden border-b border-gray-200/50 bg-gradient-to-b from-gray-50 to-white">
  <div class="absolute inset-0 bg-grid opacity-20"></div>
  <div class="relative mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-gray-500" aria-label="Breadcrumb">
      <%= link_to "Blog", blog_path, class: "hover:text-gray-700 transition-colors" %>
      <% if @blog_post.blog_category %>
        <span class="mx-2 text-gray-300">/</span>
        <%= link_to @blog_post.blog_category.name, blog_path(category: @blog_post.blog_category.slug), class: "hover:text-gray-700 transition-colors" %>
      <% end %>
    </nav>

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl leading-tight"><%= @blog_post.title %></h1>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500">
      <span><%= @blog_post.published_on.strftime("%B %-d, %Y") %></span>
      <span class="text-gray-300">&middot;</span>
      <span><%= pluralize(@blog_post.reading_time, "min") %> read</span>
      <span class="text-gray-300">&middot;</span>
      <span><%= @blog_post.admin_user&.full_name || "PactBadger Team" %></span>
      <% if @blog_post.blog_category %>
        <span class="inline-flex items-center rounded-full bg-amber-100/80 px-2.5 py-0.5 text-xs font-semibold text-amber-800"><%= @blog_post.blog_category.name %></span>
      <% end %>
    </div>
  </div>
</section>

<%# ── Article ── %>
<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
  <% if @blog_post.featured_image.attached? %>
    <%= image_tag @blog_post.featured_image, alt: @blog_post.title, class: "mb-10 w-full rounded-2xl border border-gray-200/50 object-cover shadow-sm" %>
  <% end %>

  <article class="prose prose-gray prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-amber-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
    <%= render_blog_markdown(@blog_post) %>
  </article>

  <%# Navigation %>
  <div class="mt-14 grid gap-4 border-t border-gray-200/50 pt-8 sm:grid-cols-2">
    <div>
      <% if @previous_post %>
        <p class="text-xs uppercase tracking-wide text-gray-400">Previous</p>
        <%= link_to @previous_post.title, blog_post_path(@previous_post.slug), class: "mt-1.5 block text-sm font-semibold text-gray-900 hover:text-amber-700 transition-colors" %>
      <% end %>
    </div>
    <div class="text-left sm:text-right">
      <% if @next_post %>
        <p class="text-xs uppercase tracking-wide text-gray-400">Next</p>
        <%= link_to @next_post.title, blog_post_path(@next_post.slug), class: "mt-1.5 block text-sm font-semibold text-gray-900 hover:text-amber-700 transition-colors" %>
      <% end %>
    </div>
  </div>

  <%# CTA ── %>
  <div class="mt-14 rounded-2xl bg-gradient-to-br from-amber-50 via-orange-50/50 to-amber-50 p-8 text-center ring-1 ring-amber-200/40 sm:p-10">
    <h2 class="text-2xl font-bold text-gray-900">Ready to track your contracts smarter?</h2>
    <p class="mt-2 text-sm text-gray-600">Upload contracts, extract key clauses, and never miss a deadline.</p>
    <div class="mt-6">
      <%= link_to "Start free", new_registration_path,
          class: "inline-flex items-center rounded-full bg-gray-900 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-gray-800 hover:shadow-xl transition-all duration-200" %>
    </div>
    <p class="mt-3 text-xs text-gray-500">No credit card required</p>
  </div>
</section>
